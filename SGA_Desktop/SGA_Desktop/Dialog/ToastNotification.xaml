<Window x:Class="SGA_Desktop.Dialog.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notificación"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        MaxWidth="400"
        MinWidth="300">
    
    <Window.Resources>
        <!-- Animación de entrada (fade in) -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1"
                           Duration="0:0:0.3"/>
        </Storyboard>
        
        <!-- Animación de salida (fade out) -->
        <Storyboard x:Key="FadeOutAnimation" Completed="FadeOutAnimation_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1" To="0"
                           Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="8"
            Background="{Binding ColorFondo, RelativeSource={RelativeSource AncestorType=Window}}"
            BorderBrush="{Binding ColorBorde, RelativeSource={RelativeSource AncestorType=Window}}"
            BorderThickness="2"
            Padding="16"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Icono según tipo -->
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="24"
                       Foreground="{Binding ColorIcono, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            
            <!-- Contenido: Título y Mensaje -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource FuentePrincipal}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Black"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                
                <TextBlock x:Name="MessageText"
                           FontFamily="{StaticResource FuentePrincipal}"
                           FontSize="14"
                           Foreground="#666"
                           TextWrapping="Wrap"
                           MaxHeight="200"/>
            </StackPanel>
            
            <!-- Botón cerrar (más visible) -->
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Content="✕"
                    Width="24"
                    Height="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#666"
                    FontSize="14"
                    FontWeight="Bold"
                    Padding="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    Click="CloseButton_Click"
                    ToolTip="Cerrar"
                    MouseLeftButtonDown="CloseButton_MouseLeftButtonDown"/>
        </Grid>
    </Border>
</Window>
