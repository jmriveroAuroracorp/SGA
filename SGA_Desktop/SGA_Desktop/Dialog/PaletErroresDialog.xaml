<Window x:Class="SGA_Desktop.Dialog.PaletErroresDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traspasos con ERROR ERP"
        Width="800"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Traspasos de palet en ERROR ERP"
                           FontWeight="Bold"
                           FontSize="18"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Cargando..."
                               Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button Content="Actualizar"
                            Command="{Binding RefrescarCommand}"
                            Width="110"
                            Style="{StaticResource EstiloBotonPrincipal}"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Traspasos}"
                      SelectedItem="{Binding TraspasoSeleccionado}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="0,0,0,15"
                      MinHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Palet" Binding="{Binding CodigoPalet}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Artículo" Binding="{Binding CodigoArticulo}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat=N3}" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="Destino" Binding="{Binding AlmacenDestino}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding UbicacionDestino}" Width="Auto" MinWidth="130"/>
                    <DataGridTextColumn Header="Estado ERP" Binding="{Binding EstadoErp}" Width="Auto" MinWidth="150"/>
                    <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cerrar"
                        Width="90"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Style="{StaticResource EstiloBotonSecundario}"/>
                <Button Content="Relanzar traspaso"
                        Width="160"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding RelanzarCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

