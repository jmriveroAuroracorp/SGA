<Window x:Class="SGA_Desktop.Dialog.CrearOrdenConteoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SGA_Desktop.ViewModels"
        xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="CREAR ORDEN DE CONTEO"
        Width="800"
        Height="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- DataContext -->
    <Window.DataContext>
        <vm:CrearOrdenConteoDialogViewModel />
    </Window.DataContext>

    <!-- Recursos -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Marco principal -->
    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BrushPrincipal}" 
                    CornerRadius="6,6,0,0">
                <Grid>
                    <TextBlock Text="🔄 CREAR ORDEN DE CONTEO" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <!-- Botón cerrar -->
                    <Button Content="✕" 
                            Width="30" 
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Style="{StaticResource EstiloBotonPrincipal}"
                            Command="{Binding CancelarCommand}"
                            FontSize="14"/>
                </Grid>
            </Border>

            <!-- Contenido principal -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                <StackPanel>
                    <!-- Información básica -->
                    <GroupBox Header="📝 Información Básica" Margin="0,0,0,15">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Título -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                <TextBlock Text="Título *" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                         Height="35"
                                         FontSize="14"
                                         Padding="8"
                                         BorderThickness="1"
                                         BorderBrush="{StaticResource BrushInputBorde}"/>
                            </StackPanel>

                           <!-- Tipo de Conteo -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Tipo de Conteo *" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Por Ubicación" 
                                               IsChecked="{Binding EsConteoUbicacion}"
                                               GroupName="TipoConteo"
                                               Margin="0,0,15,0"
                                               VerticalAlignment="Center"/>
                                    <RadioButton Content="Por Artículo" 
                                               IsChecked="{Binding EsConteoArticulo, Mode=OneWay}"
                                               GroupName="TipoConteo"
                                               VerticalAlignment="Center"
                                               Click="RadioButton_Articulo_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Prioridad -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Prioridad" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding PrioridadesDisponibles}"
                                          DisplayMemberPath="Nombre"
                                          SelectedItem="{Binding PrioridadSeleccionada}"
                                          Height="35"
                                          FontSize="14"
                                          Padding="8"/>
                            </StackPanel>

                            <!-- Almacén -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Almacén" FontWeight="Bold"/>
                                    <TextBlock Text=" (opcional en conteos por artículo)" 
                                               FontSize="10" 
                                               Foreground="#6C757D" 
                                               FontStyle="Italic"
                                               Margin="5,0,0,0"
                                               Visibility="{Binding MostrarConteoArticulo, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                
                                <!-- CheckBox modo multialmacén (solo visible en modo artículo) -->
                                <CheckBox Content="Conteo multialmacén" 
                                          IsChecked="{Binding ModoMultialmacen}"
                                          FontSize="12"
                                          Foreground="Gray"
                                          Margin="0,0,0,5"
                                          Visibility="{Binding MostrarConteoArticulo, Converter={StaticResource BoolToVis}}"/>
                                
                                <!-- ComboBox modo único (cuando ModoMultialmacen = false) -->
                                <ComboBox ItemsSource="{Binding AlmacenesView}"
                                          DisplayMemberPath="DescripcionCombo"
                                          SelectedItem="{Binding AlmacenSeleccionado}"
                                          Height="35"
                                          FontSize="14"
                                          Padding="8"
                                          IsEditable="True"
                                          Visibility="{Binding ModoMultialmacen, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                
                                <!-- Panel modo múltiple (cuando ModoMultialmacen = true) -->
                                <Grid Visibility="{Binding ModoMultialmacen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Resumen de selección -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding DescripcionAlmacenesSeleccionados}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"/>
                                    
                                    <!-- Lista de almacenes con CheckBoxes -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto" 
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="200">
                                        <ItemsControl ItemsSource="{Binding AlmacenesView}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DescripcionCombo}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="2,4"
                                                              Padding="4,2"
                                                              FontSize="13"
                                                              Cursor="Hand">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- Operario -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Operario Asignado *" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding OperariosView}"
                                          DisplayMemberPath="NombreOperario"
                                          SelectedItem="{Binding OperarioSeleccionado}"
                                          Text="{Binding FiltroOperarios, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsDropDownOpen="{Binding IsDropDownOpenOperarios}"
                                          Height="35"
                                          FontSize="14"
                                          Padding="8"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          MaxDropDownHeight="200">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding CerrarDropDownOperariosCommand}"/>
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="GotFocus">
                                            <i:InvokeCommandAction Command="{Binding AbrirDropDownOperariosCommand}"/>
                                        </i:EventTrigger>
                                        <i:EventTrigger EventName="TextChanged">
                                            <i:InvokeCommandAction Command="{Binding LimpiarSeleccionOperariosCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                            </StackPanel>



                            <!-- Visibilidad -->
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                <TextBlock Text="Visibilidad" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding VisibilidadesDisponibles}"
                                          SelectedItem="{Binding VisibilidadSeleccionada}"
                                          DisplayMemberPath="Texto"
                                          Height="35"
                                          FontSize="14"
                                          Padding="8"
                                          MinWidth="200">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Content="{Binding Descripcion}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>

                            <!-- Fecha -->
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="Fecha Planificada" FontWeight="Bold" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding FechaPlan}"
                                           Height="35"
                                           FontSize="14"/>
                            </StackPanel>


                        </Grid>
                    </GroupBox>

                    <!-- Filtros específicos -->
                    <GroupBox Header="🎯 Filtros de Conteo" Margin="0,0,0,15">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Información sobre filtros opcionales -->
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" 
                                       Text="ℹ️ Los filtros son opcionales. Selecciona solo los que necesites. Si no seleccionas nada, se hará conteo de todo el almacén."
                                       FontSize="11" 
                                       Foreground="#6C757D" 
                                       FontStyle="Italic" 
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding MostrarConteoUbicacion, Converter={StaticResource BoolToVis}}"/>

                            <!-- CheckBox para elegir modo -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                    Background="#F8F9FA"
                                    BorderBrush="#E9ECEF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding MostrarConteoUbicacion, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox Content="Usar ubicación directa (en lugar de filtros secuenciales)"
                                              IsChecked="{Binding UsarUbicacionDirecta}"
                                              FontWeight="SemiBold"
                                              Foreground="#495057"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- CheckBox para activar modo rangos -->
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                      Content="Usar rangos de ubicación"
                                      IsChecked="{Binding UsarRangos}"
                                      Margin="0,0,0,10"
                                      Visibility="{Binding MostrarFiltrosSecuenciales, Converter={StaticResource BoolToVis}}"
                                      FontSize="13"
                                      Foreground="#495057"/>

                            <!-- Filtros por ubicación secuencial -->
                            <Border Grid.Row="3" Grid.Column="0" 
                                    Background="#FFFFFF"
                                    BorderBrush="#E9ECEF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,5,10"
                                    Visibility="{Binding MostrarFiltrosSecuenciales, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🏢" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Pasillo" FontWeight="SemiBold" Foreground="#495057"/>
                                        <TextBlock Text=" (opcional)" FontSize="11" Foreground="#6C757D" FontStyle="Italic"/>
                                    </StackPanel>
                                    <!-- Modo normal: ComboBox -->
                                    <ComboBox ItemsSource="{Binding PasillosDisponibles}"
                                              SelectedItem="{Binding Pasillo}"
                                              Height="32"
                                              FontSize="13"
                                              Padding="8"
                                              IsEditable="False"
                                              BorderBrush="#CED4DA"
                                              Background="White"
                                              Visibility="{Binding UsarRangos, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <!-- Modo rango: TextBox Desde/Hasta -->
                                    <StackPanel Orientation="Horizontal" 
                                                Visibility="{Binding UsarRangos, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding PasilloDesde, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 Margin="0,0,3,0"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="a" 
                                                   VerticalAlignment="Center" 
                                                   Margin="3,0"
                                                   Foreground="#6C757D"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding PasilloHasta, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="1" 
                                    Background="#FFFFFF"
                                    BorderBrush="#E9ECEF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="5,0,5,10"
                                    Visibility="{Binding MostrarFiltrosSecuenciales, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📚" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Estantería" FontWeight="SemiBold" Foreground="#495057"/>
                                        <TextBlock Text=" (opcional)" FontSize="11" Foreground="#6C757D" FontStyle="Italic"/>
                                    </StackPanel>
                                    <!-- Modo normal: ComboBox -->
                                    <ComboBox ItemsSource="{Binding EstanteriasDisponibles}"
                                              SelectedItem="{Binding Estanteria}"
                                              Height="32"
                                              FontSize="13"
                                              Padding="8"
                                              IsEditable="False"
                                              BorderBrush="#CED4DA"
                                              Background="White"
                                              IsEnabled="{Binding EstanteriaHabilitada}"
                                              Visibility="{Binding UsarRangos, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <!-- Modo rango: TextBox Desde/Hasta -->
                                    <StackPanel Orientation="Horizontal" 
                                                Visibility="{Binding UsarRangos, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding EstanteriaDesde, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 Margin="0,0,3,0"
                                                 VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding EstanteriaHabilitada}"/>
                                        <TextBlock Text="a" 
                                                   VerticalAlignment="Center" 
                                                   Margin="3,0"
                                                   Foreground="#6C757D"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding EstanteriaHasta, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 VerticalContentAlignment="Center"
                                              IsEnabled="{Binding EstanteriaHabilitada}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="2" 
                                    Background="#FFFFFF"
                                    BorderBrush="#E9ECEF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="5,0,5,10"
                                    Visibility="{Binding MostrarFiltrosSecuenciales, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📏" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Altura" FontWeight="SemiBold" Foreground="#495057"/>
                                        <TextBlock Text=" (opcional)" FontSize="11" Foreground="#6C757D" FontStyle="Italic"/>
                                    </StackPanel>
                                    <!-- Modo normal: ComboBox -->
                                    <ComboBox ItemsSource="{Binding AlturasDisponibles}"
                                              SelectedItem="{Binding Altura}"
                                              Height="32"
                                              FontSize="13"
                                              Padding="8"
                                              IsEditable="False"
                                              BorderBrush="#CED4DA"
                                              Background="White"
                                              IsEnabled="{Binding AlturaHabilitada}"
                                              Visibility="{Binding UsarRangos, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <!-- Modo rango: TextBox Desde/Hasta -->
                                    <StackPanel Orientation="Horizontal" 
                                                Visibility="{Binding UsarRangos, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding AlturaDesde, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 Margin="0,0,3,0"
                                                 VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding AlturaHabilitada}"/>
                                        <TextBlock Text="a" 
                                                   VerticalAlignment="Center" 
                                                   Margin="3,0"
                                                   Foreground="#6C757D"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding AlturaHasta, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 VerticalContentAlignment="Center"
                                              IsEnabled="{Binding AlturaHabilitada}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="3" 
                                    Background="#FFFFFF"
                                    BorderBrush="#E9ECEF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="5,0,0,10"
                                    Visibility="{Binding MostrarFiltrosSecuenciales, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Posición" FontWeight="SemiBold" Foreground="#495057"/>
                                        <TextBlock Text=" (opcional)" FontSize="11" Foreground="#6C757D" FontStyle="Italic"/>
                                    </StackPanel>
                                    <!-- Modo normal: ComboBox -->
                                    <ComboBox ItemsSource="{Binding PosicionesDisponibles}"
                                              SelectedItem="{Binding Posicion}"
                                              Height="32"
                                              FontSize="13"
                                              Padding="8"
                                              IsEditable="False"
                                              BorderBrush="#CED4DA"
                                              Background="White"
                                              IsEnabled="{Binding PosicionHabilitada}"
                                              Visibility="{Binding UsarRangos, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <!-- Modo rango: TextBox Desde/Hasta -->
                                    <StackPanel Orientation="Horizontal" 
                                                Visibility="{Binding UsarRangos, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding PosicionDesde, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 Margin="0,0,3,0"
                                                 VerticalContentAlignment="Center"
                                                 IsEnabled="{Binding PosicionHabilitada}"/>
                                        <TextBlock Text="a" 
                                                   VerticalAlignment="Center" 
                                                   Margin="3,0"
                                                   Foreground="#6C757D"
                                                   FontSize="11"/>
                                        <TextBox Text="{Binding PosicionHasta, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50"
                                                 Height="28"
                                                 FontSize="12"
                                                 Padding="4"
                                                 BorderBrush="#CED4DA"
                                                 VerticalContentAlignment="Center"
                                              IsEnabled="{Binding PosicionHabilitada}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ubicación Directa -->
                            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                                    Background="#E3F2FD"
                                    BorderBrush="#2196F3"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding UsarUbicacionDirecta, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🎯" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Ubicación Directa" FontWeight="SemiBold" Foreground="#1976D2"/>
                                        <TextBlock Text=" (opcional)" FontSize="11" Foreground="#1976D2" FontStyle="Italic"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding UbicacionesDisponibles}"
                                              SelectedItem="{Binding UbicacionDirecta}"
                                              Height="32"
                                              FontSize="13"
                                              Padding="8"
                                              IsEditable="True"
                                              BorderBrush="#2196F3"
                                              Background="White"
                                              Foreground="#1976D2"/>
                                </StackPanel>
                            </Border>

                            <!-- Filtro por artículo -->
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,10"
                                       Visibility="{Binding MostrarConteoArticulo, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Buscar Artículo" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="ℹ️ Busca el artículo por código o descripción. Si no hay stock virtual, se permitirá crear el conteo igualmente (puede haber stock físico no registrado)." 
                                           FontSize="12" 
                                           Foreground="#6C757D" 
                                           FontStyle="Italic" 
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>
                                
                                <!-- Campo de búsqueda -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ArticuloBuscado, UpdateSourceTrigger=PropertyChanged}"
                                             Height="35"
                                             FontSize="14"
                                             Padding="8"
                                             Margin="0,0,10,0"/>
                                    
                                    <Button Grid.Column="1"
                                            Content="🔍 Buscar"
                                            Command="{Binding BuscarArticuloCommand}"
                                            Style="{StaticResource EstiloBotonPrincipal}"
                                            Width="100"
                                            Height="35"
                                            FontSize="12"/>
                                </Grid>
                                
                                <!-- Lista de artículos seleccionados -->
                                <Border Visibility="{Binding MostrarListaArticulos, Converter={StaticResource BoolToVis}}"
                                        Background="#E7F3FF"
                                        BorderBrush="#2196F3"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📋 Artículos seleccionados:" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding DescripcionArticulosSeleccionados}" 
                                                   FontSize="12" 
                                                   Foreground="#1976D2" 
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding ArticulosSeleccionados}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White"
                                                            BorderBrush="#BBDEFB"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="8"
                                                            Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock FontWeight="Bold" FontSize="12">
                                                                    <Run Text="{Binding CodigoArticulo}"/>
                                                                    <Run Text=" - "/>
                                                                    <Run Text="{Binding DescripcionArticulo}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Content="✕ Eliminar"
                                                                    Command="{Binding DataContext.EliminarArticuloCommand, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource EstiloBotonSecundario}"
                                                                    Width="90"
                                                                    Height="28"
                                                                    FontSize="11"
                                                                    Margin="10,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Lista desplegable para múltiples resultados -->
                                <StackPanel Visibility="{Binding MostrarListaArticulos, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,10">
                                    <TextBlock Text="Selecciona el artículo:" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding ArticulosEncontrados}"
                                              SelectedItem="{Binding ArticuloSeleccionado}"
                                              Height="35"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CodigoArticulo}" FontWeight="Bold" Margin="0,0,10,0"/>
                                                    <TextBlock Text="-" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding DescripcionArticulo}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Información del artículo seleccionado -->
                                <Border Visibility="{Binding MostrarInfoArticulo, Converter={StaticResource BoolToVis}}"
                                        Background="#F8F9FA"
                                        BorderBrush="#DEE2E6"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="✅ Artículo seleccionado:" FontWeight="Bold" Foreground="#198754" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="Código: " FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ArticuloSeleccionado.CodigoArticulo}" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Descripción: " FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ArticuloSeleccionado.DescripcionArticulo}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Advertencia cuando NO hay stock virtual -->
                                <Border Visibility="{Binding MostrarAdvertenciaSinStock, Converter={StaticResource BoolToVis}}"
                                        Background="#FFF3CD"
                                        BorderBrush="#FFC107"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="⚠️" FontSize="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="ADVERTENCIA: Sin Stock Virtual" FontWeight="Bold" Foreground="#856404" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Foreground="#856404" FontSize="12" LineHeight="18">
                                            <Run Text="Este artículo no tiene stock virtual registrado en el sistema." FontWeight="Bold"/>
                                            <LineBreak/>
                                            <LineBreak/>
                                            <Run Text="El operario que realice el conteo tendrá que crear el registro manualmente cuando encuentre stock físico."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Comentario -->
                            <StackPanel Grid.Row="6" Grid.ColumnSpan="4" Margin="0,0,0,15">
                                <TextBlock Text="Comentarios" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Comentario, UpdateSourceTrigger=PropertyChanged}"
                                         Height="60"
                                         FontSize="14"
                                         Padding="8"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- Conteo Periódico -->
                            <StackPanel Grid.Row="7" Grid.ColumnSpan="4" Margin="0,0,0,0">
                                <CheckBox Content="🔄 Conteo Periódico"
                                          IsChecked="{Binding EsPeriodico}"
                                          FontWeight="Bold"
                                          FontSize="14"
                                          Margin="0,0,0,10"/>
                                
                                <StackPanel Visibility="{Binding EsPeriodico, Converter={StaticResource BoolToVis}}"
                                            Margin="20,0,0,0">
                                    <TextBlock Text="Frecuencia (días) *" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding FrecuenciaDias, UpdateSourceTrigger=PropertyChanged}"
                                             Height="35"
                                             FontSize="14"
                                             Padding="8"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BrushInputBorde}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CrearOrdenCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="Ejemplo: 7 para conteos semanales, 30 para mensuales"
                                               FontSize="11"
                                               Foreground="Gray"
                                               Margin="0,5,0,0"
                                               FontStyle="Italic"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Información de estado -->
                    <StackPanel Visibility="{Binding IsCargando, Converter={StaticResource BoolToVis}}"
                               Orientation="Horizontal"
                               Margin="0,10,0,0">
                        <ProgressBar Width="20" Height="20" 
                                     IsIndeterminate="True" 
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding MensajeEstado}" 
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushSecundario}"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Botones de acción -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushSecundario}">
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center"
                           Margin="20,10">
                    <Button Content="Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource EstiloBotonSecundario}"
                            Width="100"
                            Height="35"
                            Margin="0,0,10,0"/>
                    <Button Content="Crear Orden"
                            Command="{Binding CrearOrdenCommand}"
                            Style="{StaticResource EstiloBotonPrincipal}"
                            Width="120"
                            Height="35"
                            IsEnabled="{Binding PuedeCrearOrden}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window> 
