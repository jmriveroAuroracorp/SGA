<Window x:Class="SGA_Desktop.Dialog.HistorialRenovacionesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
        Title="Historial de Renovaciones" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <helpers:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <!-- Marco redondeado con fondo y bordes -->
    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BrushPrincipal}" 
                    CornerRadius="6,6,0,0">
                <Grid>
                    <TextBlock Text="🔄 HISTORIAL DE RENOVACIONES" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" 
                            Width="30" 
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="CerrarButton_Click"
                            Cursor="Hand"/>
                </Grid>
            </Border>
            
            <!-- Resumen -->
            <Border Grid.Row="1" 
                    Background="#E8F4FD" 
                    BorderBrush="#3498DB" 
                    BorderThickness="0,0,0,1"
                    Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="{Binding TituloConteo}" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#2980B9"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,10,0">
                        <TextBlock Text="Total: " FontWeight="SemiBold" Foreground="#666" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TotalRenovaciones}" FontWeight="Bold" Foreground="#333"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="Cumplidas: " FontWeight="SemiBold" Foreground="#666" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding RenovacionesCumplidas}" FontWeight="Bold" Foreground="#28A745"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="Cumplimiento: " FontWeight="SemiBold" Foreground="#666" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding PorcentajeCumplimiento, StringFormat='{}{0:F1}%'}" 
                                   FontWeight="Bold" 
                                   Foreground="#28A745"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Contenido -->
            <Grid Grid.Row="2" Margin="20">
                <!-- Estado de carga -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="{Binding IsCargando, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Width="50" Height="50" IsIndeterminate="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Cargando renovaciones..." 
                               FontSize="12" 
                               Foreground="#666"/>
                </StackPanel>
                
                <!-- Tabla de renovaciones -->
                <Border Background="White"
                        BorderBrush="#E1E5E9"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsCargando, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header de columnas (fijo) -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BrushPrincipal}" 
                                BorderBrush="{StaticResource BrushIntermedio}" 
                                BorderThickness="0,0,0,1"
                                Padding="12,10"
                                CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="Fecha Creación" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="Estado" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Título" FontWeight="Bold" FontSize="11" Foreground="White" Margin="8,0"/>
                                <TextBlock Grid.Column="3" Text="Operario" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                <TextBlock Grid.Column="4" Text="Fecha Inicio" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Fecha Cierre" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Cumplido" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lista de renovaciones (scrolleable) -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- Lista de renovaciones -->
                                <ItemsControl ItemsSource="{Binding Renovaciones}"
                                              Visibility="{Binding TieneRenovaciones, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="#E1E5E9"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Fecha Creación -->
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding FechaCreacion, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" 
                                                               FontSize="12" 
                                                               Foreground="#333"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Estado -->
                                                    <Border Grid.Column="1" 
                                                            Margin="5,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                                <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="CERRADO">
                                                                        <Setter Property="Background" Value="#D4EDDA"/>
                                                                        <Setter Property="BorderBrush" Value="#28A745"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="EN_PROCESO">
                                                                        <Setter Property="Background" Value="#D1ECF1"/>
                                                                        <Setter Property="BorderBrush" Value="#198754"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="ASIGNADO">
                                                                        <Setter Property="Background" Value="#FFF3CD"/>
                                                                        <Setter Property="BorderBrush" Value="#FD7E14"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="PLANIFICADO">
                                                                        <Setter Property="Background" Value="#D1ECF1"/>
                                                                        <Setter Property="BorderBrush" Value="#0D6EFD"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="CANCELADO">
                                                                        <Setter Property="Background" Value="#F8D7DA"/>
                                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EstadoFormateado}" 
                                                                   FontWeight="SemiBold" 
                                                                   FontSize="11"
                                                                   Foreground="#333"/>
                                                    </Border>
                                                    
                                                    <!-- Título -->
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Titulo}" 
                                                               FontSize="12" 
                                                               Foreground="#333"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"
                                                               ToolTipService.ToolTip="{Binding Titulo}"/>
                                                    
                                                    <!-- Operario -->
                                                    <TextBlock Grid.Column="3" 
                                                               Text="{Binding OperarioDisplay, Mode=OneWay}" 
                                                               FontSize="12" 
                                                               Foreground="#333"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Fecha Inicio -->
                                                    <TextBlock Grid.Column="4" 
                                                               Text="{Binding FechaInicio, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='N/A'}" 
                                                               FontSize="12" 
                                                               Foreground="#666"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Fecha Cierre -->
                                                    <TextBlock Grid.Column="5" 
                                                               Text="{Binding FechaCierre, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='N/A'}" 
                                                               FontSize="12" 
                                                               Foreground="#666"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Cumplido -->
                                                    <TextBlock Grid.Column="6" 
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="❌"/>
                                                                <Setter Property="FontSize" Value="16"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Estado}" Value="CERRADO">
                                                                        <Setter Property="Text" Value="✅"/>
                                                                        <Setter Property="Foreground" Value="#28A745"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Mensaje cuando no hay renovaciones -->
                                <Border Background="#F8F9FA"
                                        BorderBrush="#E1E5E9"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="40"
                                        Visibility="{Binding TieneRenovaciones, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📋" 
                                                   FontSize="48" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,16"/>
                                        <TextBlock Text="No hay renovaciones registradas" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushSecundario}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Botón Cerrar -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Margin="20,0,20,0">
                <Button Content="Cerrar" 
                        Width="100" 
                        Height="35" 
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Click="CerrarButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
