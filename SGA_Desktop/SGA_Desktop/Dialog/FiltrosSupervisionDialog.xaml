<Window x:Class="SGA_Desktop.Dialog.FiltrosSupervisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Filtros de Supervisión"
        Width="550"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filtros organizados de arriba a abajo -->
            <GroupBox Header="Filtros" Grid.Row="0" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ver todos los resultados -->
                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                 Content="Ver todos los resultados"
                                 IsChecked="{Binding VerTodosLosResultados}"
                                 Margin="0,0,0,10"
                                 FontSize="12"
                                 VerticalAlignment="Center"/>

                        <!-- Fecha desde -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha desde:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding FechaDesde}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200" Margin="0,0,0,0"/>

                        <!-- Fecha hasta -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fecha hasta:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding FechaHasta}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200" Margin="0,10,0,0"/>

                        <!-- Diferencia desde -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Diferencia desde:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding DiferenciaDesde, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EstiloCajaTexto}" 
                                 Height="30" 
                                 Width="200"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4"
                                 Margin="0,10,0,0"/>

                        <!-- Diferencia hasta -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Diferencia hasta:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" 
                                 Text="{Binding DiferenciaHasta, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EstiloCajaTexto}" 
                                 Height="30" 
                                 Width="200"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4"
                                 Margin="0,10,0,0"/>

                        <!-- Almacén -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Almacén:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" 
                                  ItemsSource="{Binding AlmacenesComboView}"
                                  SelectedItem="{Binding AlmacenSeleccionado}"
                                  Text="{Binding FiltroAlmacenesTexto, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource EstiloComboBox}" Height="30"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  IsDropDownOpen="{Binding IsDropDownOpenAlmacenes}"
                                  Margin="0,10,0,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding AbrirDropDownAlmacenesCommand}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CerrarDropDownAlmacenesCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>

                        <!-- Ubicación -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Ubicación:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" 
                                  ItemsSource="{Binding UbicacionesComboView}"
                                  SelectedItem="{Binding UbicacionSeleccionada}"
                                  Text="{Binding FiltroUbicacionesTexto, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource EstiloComboBox}" Height="30"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  IsDropDownOpen="{Binding IsDropDownOpenUbicaciones}"
                                  Margin="0,10,0,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding AbrirDropDownUbicacionesCommand}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CerrarDropDownUbicacionesCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>

                        <!-- Operario que hizo el conteo -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Operario:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" 
                                  ItemsSource="{Binding OperariosComboView}"
                                  DisplayMemberPath="NombreOperario"
                                  SelectedItem="{Binding OperarioSeleccionado}"
                                  Text="{Binding FiltroOperariosTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding IsDropDownOpenOperarios}"
                                  Style="{StaticResource EstiloComboBox}" 
                                  Height="30" 
                                  Width="200"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  MaxDropDownHeight="200"
                                  Margin="0,10,0,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding CerrarDropDownOperariosCommand}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="GotFocus">
                                    <i:InvokeCommandAction Command="{Binding AbrirDropDownOperariosCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <!-- Botones: Aplicar, Limpiar, Cancelar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Aplicar" 
                        Command="{Binding AplicarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}" 
                        Width="100" Height="35" Margin="0,0,8,0"/>
                <Button Content="Limpiar" 
                        Command="{Binding LimpiarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Width="100" Height="35" Margin="0,0,8,0"/>
                <Button Content="Cancelar" 
                        IsCancel="True" 
                        Command="{Binding CerrarCommand}" 
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Width="100" Height="35"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
