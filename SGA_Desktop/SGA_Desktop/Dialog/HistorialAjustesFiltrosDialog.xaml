<Window x:Class="SGA_Desktop.Dialog.HistorialAjustesFiltrosDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:Helpers="clr-namespace:SGA_Desktop.Helpers"
        Title="Filtros de Historial de Ajustes"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Fecha desde -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fecha desde:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding FechaDesde}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200"/>

            <!-- Fecha hasta -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha hasta:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding FechaHasta}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200" Margin="0,10,0,0"/>

            <!-- Código artículo -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Código artículo:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CodigoArticulo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCajaTexto}" Height="30" Width="200" Margin="0,10,0,0" VerticalContentAlignment="Center" Padding="8,4"/>

            <!-- Lote -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Lote:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CodigoLote, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding PuedeFiltrarPorLote}"
                     Style="{StaticResource EstiloCajaTexto}" Height="30" Width="200" Margin="0,10,0,0" VerticalContentAlignment="Center" Padding="8,4"/>

            <!-- Código palet -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Código palet:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CodigoPalet, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCajaTexto}" Height="30" Width="200" Margin="0,10,0,0" VerticalContentAlignment="Center" Padding="8,4"/>

            <!-- Estado -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Estado:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Estados}" SelectedItem="{Binding EstadoSeleccionado}" DisplayMemberPath="Descripcion" Style="{StaticResource EstiloComboBox}" Height="30" Width="200" Margin="0,10,0,0"/>

            <!-- Almacén -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Almacén:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <ComboBox Grid.Row="6" Grid.Column="1" 
                      ItemsSource="{Binding AlmacenesView}"
                      SelectedItem="{Binding AlmacenSeleccionado}"
                      Text="{Binding FiltroAlmacenes, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="DescripcionCombo"
                      Style="{StaticResource EstiloComboBox}" 
                      Height="30"
                      Width="200"
                      Margin="0,10,0,0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      IsDropDownOpen="{Binding IsDropDownOpenAlmacenes}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="GotFocus">
                        <i:InvokeCommandAction Command="{Binding AbrirDropDownAlmacenesCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding CerrarDropDownAlmacenesCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <!-- Operario -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Operario:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <ComboBox Grid.Row="7" Grid.Column="1" 
                      ItemsSource="{Binding OperariosView}"
                      DisplayMemberPath="NombreOperario"
                      SelectedItem="{Binding OperarioSeleccionado}"
                      Text="{Binding FiltroOperarios, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsDropDownOpen="{Binding IsDropDownOpenOperarios}"
                      Style="{StaticResource EstiloComboBox}" 
                      Height="30"
                      Width="200"
                      Margin="0,10,0,0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      MaxDropDownHeight="200">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding CerrarDropDownOperariosCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="GotFocus">
                        <i:InvokeCommandAction Command="{Binding AbrirDropDownOperariosCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <!-- Origen -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Origen:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
            <ComboBox Grid.Row="8" Grid.Column="1" 
                      ItemsSource="{Binding Origenes}"
                      SelectedItem="{Binding OrigenSeleccionado}"
                      DisplayMemberPath="Descripcion"
                      Style="{StaticResource EstiloComboBox}" 
                      Height="30"
                      Width="200"
                      Margin="0,10,0,0"/>

            <!-- Botones -->
            <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <Button Content="Aplicar" 
                        Width="100" 
                        Height="35" 
                        Command="{Binding AplicarFiltrosCommand}"
                        IsDefault="True"
                        Style="{StaticResource EstiloBotonPrincipal}" 
                        Margin="0,0,10,0"
                        Click="AplicarButton_Click"/>
                <Button Content="Limpiar" 
                        Width="100" 
                        Height="35" 
                        Command="{Binding LimpiarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonSecundario}"
                        Margin="0,0,10,0"/>
                <Button Content="Cancelar" 
                        Width="100" 
                        Height="35" 
                        IsCancel="True"
                        Style="{StaticResource EstiloBotonSecundario}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

