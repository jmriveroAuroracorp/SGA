<Window x:Class="SGA_Desktop.Dialog.TraspasoPaletDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traspaso de palet"
        Width="500" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:UbicacionConverter x:Key="UbicacionConverter" xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- CONTENIDO PRINCIPAL -->
            <StackPanel Grid.Row="0">
                <!-- CABECERA -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Traspaso de palet" Style="{StaticResource LabelStyle}" FontWeight="Bold" FontSize="18"/>
                </StackPanel>

                <!-- INFORMACIÓN DEL PALET -->
                <Border Background="White" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,0,0,20"
                        BorderBrush="{StaticResource BrushPrincipal}"
                        BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Información del palet:" Style="{StaticResource LabelStyle}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Código:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PaletSeleccionado.Codigo}" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Estado:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PaletSeleccionado.Estado}" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Almacén:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PaletSeleccionado.AlmacenOrigen}" Foreground="{StaticResource BrushGrisOscuro}" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ubicación:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PaletSeleccionado.UbicacionOrigen, Converter={StaticResource UbicacionConverter}}" Foreground="{StaticResource BrushGrisOscuro}" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Último traspaso:" FontWeight="SemiBold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PaletSeleccionado.FechaUltimoTraspaso, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource BrushGrisOscuro}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SELECCIÓN DE DESTINO -->
                <StackPanel>
                    <TextBlock Text="Destino del traspaso:" Style="{StaticResource LabelStyle}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Almacén destino:" Style="{StaticResource LabelStyle}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AlmacenesDestinoView}"
                              SelectedItem="{Binding AlmacenDestinoSeleccionado, Mode=TwoWay}"
                              DisplayMemberPath="DescripcionCombo"
                              Style="{StaticResource EstiloComboBox}"
                              Margin="0,0,0,15"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              Text="{Binding FiltroAlmacenes, UpdateSourceTrigger=PropertyChanged}"
                              PreviewKeyDown="ComboBox_PreviewKeyDown"/>
                    
                    <TextBlock Text="Ubicación destino:" Style="{StaticResource LabelStyle}" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding UbicacionesDestinoView}"
                              SelectedItem="{Binding UbicacionDestinoSeleccionada}"
                              DisplayMemberPath="Ubicacion"
                              Style="{StaticResource EstiloComboBox}"
                              Margin="0,0,0,15"
                              IsEditable="True"
                              Text="{Binding FiltroUbicaciones, UpdateSourceTrigger=PropertyChanged}"
                              PreviewKeyDown="ComboBox_PreviewKeyDown"/>
                    
                    <TextBlock Text="Comentario (opcional):" Style="{StaticResource LabelStyle}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Comentario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             AcceptsReturn="True"
                             Style="{StaticResource EstiloCajaTexto}"
                             Margin="0,0,0,10"/>
                </StackPanel>
            </StackPanel>

            <!-- Botones abajo a la derecha -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Confirmar"
                        Command="{Binding MoverPaletCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Margin="0,0,10,0"
                        IsEnabled="{Binding PuedeMoverPalet}"/>
                <Button Content="Cerrar"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Click="Cerrar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
