<Window x:Class="SGA_Desktop.Dialog.TraspasoStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Helpers="clr-namespace:SGA_Desktop.Helpers"
        Title="Traspaso de Stock"
        Width="600"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Carga de estilos globales -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Helpers:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: Origen -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="6" Margin="0,0,20,0">
                <TextBlock Text="Código artículo:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{Binding CodigoArticulo}"/>
                    
                    <!-- 🔷 NUEVO: Indicador de bloqueo por calidad -->
                    <Border Background="#FF6B6B" 
                            CornerRadius="3" 
                            Padding="4,2" 
                            Margin="8,0,0,0"
                            Visibility="{Binding IsBloqueadoCalidad, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Artículo bloqueado por calidad" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MotivoBloqueoCalidad}" 
                                               Visibility="{Binding MotivoBloqueoCalidad, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding FechaBloqueoCalidad, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}" 
                                               Visibility="{Binding FechaBloqueoCalidad, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="10" Margin="0,0,2,0"/>
                            <TextBlock Text="BLOQUEADO" 
                                       FontSize="8" 
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Artículo:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ArticuloDescripcion}" Margin="0,0,0,12"/>

                <TextBlock Text="Almacén Origen:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding AlmacenOrigenNombre}" Margin="0,0,0,12"/>

                <TextBlock Text="Ubicación Origen:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding UbicacionOrigen}" Margin="0,0,0,12"/>

                <!--  NUEVO: Información del palet -->
                <TextBlock Text="Tipo de Stock:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{Binding TipoStock}" FontWeight="Bold" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding InformacionPalet}" 
                               Foreground="{StaticResource BrushPrincipal}" 
                               FontWeight="Bold"
                               Visibility="{Binding EsStockPaletizado, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <TextBlock Text="Cantidad disponible:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CantidadDisponible, StringFormat='0.######'}" Margin="0,0,0,12"/>

                <TextBlock Text="Reservado:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8" Visibility="{Binding Reservado, Converter={StaticResource ZeroToCollapsedConverter}}"/>
                <TextBlock Text="{Binding Reservado, StringFormat='0.######'}" Margin="0,0,0,12" Visibility="{Binding Reservado, Converter={StaticResource ZeroToCollapsedConverter}}"/>

                <Border Background="#F0F6FF" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" MinWidth="250">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="Disponible:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Disponible, StringFormat='0.######'}" Foreground="{StaticResource BrushPrincipal}" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Columna derecha: Destino -->
            <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="6">
                <TextBlock Text="Almacén Destino:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding AlmacenesDestino}"
                          SelectedItem="{Binding AlmacenDestinoSeleccionado, Mode=TwoWay}"
                          DisplayMemberPath="DescripcionCombo"
                          Style="{StaticResource EstiloComboBox}" 
                          IsEditable="True"
                          Margin="0,0,0,12"/>

            <TextBlock Text="Ubicación destino:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding UbicacionesDestino}"
                      SelectedItem="{Binding UbicacionDestinoSeleccionada, Mode=TwoWay}"
                      DisplayMemberPath="UbicacionMostrada"
                      Style="{StaticResource EstiloComboBox}" 
                      IsEditable="True"
                      Margin="0,0,0,12"/>

            <!-- NUEVO: Opciones de paletización (visible solo si hay palets en destino) -->
            <Border Background="#F8F9FA" 
                    CornerRadius="6" 
                    Padding="12" 
                    Margin="0,0,0,12"
                    Visibility="{Binding MostrarOpcionesPalet, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding MensajeOpcionesPalet}" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrincipal}" 
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Vertical">
                        <!-- Opción 1: Paletizar -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <RadioButton Content="📦 Agregar al palet existente" 
                                         IsChecked="{Binding OpcionPaletizarSeleccionada, Mode=TwoWay}"
                                         Command="{Binding SeleccionarOpcionPaletizarCommand}"
                                         FontWeight="Bold"
                                         Foreground="{StaticResource BrushPrincipal}"/>
                            <ComboBox ItemsSource="{Binding PaletsDisponibles}"
                                      SelectedItem="{Binding PaletDestinoSeleccionado, Mode=TwoWay}"
                                      DisplayMemberPath="Descripcion"
                                      Style="{StaticResource EstiloComboBox}"
                                      Margin="24,6,0,0"
                                      IsEnabled="{Binding SelectorPaletsHabilitado}"
                                      IsHitTestVisible="{Binding SelectorPaletsHabilitado}"
                                      Focusable="{Binding SelectorPaletsHabilitado}"/>
                        </StackPanel>
                        
                        <!-- Opción 2: Dejar suelto -->
                        <RadioButton Content="🧱 Dejar material suelto en la ubicación" 
                                     IsChecked="{Binding OpcionDejarSueltoSeleccionada, Mode=TwoWay}"
                                     Command="{Binding SeleccionarOpcionDejarSueltoCommand}"
                                     FontWeight="Bold"
                                     Foreground="#28A745"
                                     Margin="0,0,0,8"/>
                        
                        <!-- Opción 3: Cancelar -->
                        <RadioButton Content="❌ Cancelar y buscar otra ubicación" 
                                     IsChecked="{Binding OpcionCancelarSeleccionada, Mode=TwoWay}"
                                     Command="{Binding SeleccionarOpcionCancelarCommand}"
                                     FontWeight="Bold"
                                     Foreground="#DC3545"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Cantidad a traspasar:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding CantidadATraspasarTexto, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource EstiloCajaTexto}" 
                         Margin="0,0,0,12"
                         GotFocus="TextBox_GotFocus"
                         PreviewMouseLeftButtonDown="TextBox_PreviewMouseLeftButtonDown"/>

                <TextBlock Text="Comentarios:" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding ComentariosTexto, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EstiloCajaTexto}" 
                         Height="80" 
                         MaxHeight="80"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,0,12"/>
                <!-- Aquí puedes añadir más campos de destino en el futuro -->
            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Cancelar" Width="90" Margin="0,0,10,0" IsCancel="True" Command="{Binding CancelarCommand}" Style="{StaticResource EstiloBotonPrincipal}"/>
                <Button Content="Traspasar"
                        Command="{Binding ConfirmarCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}" Width="120" Height="40" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window> 