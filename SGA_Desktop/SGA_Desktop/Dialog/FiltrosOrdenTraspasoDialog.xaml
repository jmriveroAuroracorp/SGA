<Window x:Class="SGA_Desktop.Dialog.FiltrosOrdenTraspasoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Filtros de Órdenes de Traspaso"
        Width="500"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BrushFondo}"
            BorderBrush="{StaticResource BrushPrincipal}"
            BorderThickness="2"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filtros organizados de arriba a abajo -->
            <GroupBox Header="Filtros" Grid.Row="0" Margin="0,0,0,16">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Almacén Destino -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Almacén Destino:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" 
                              ItemsSource="{Binding AlmacenesComboView}"
                              SelectedItem="{Binding AlmacenDestinoSeleccionado}"
                              Text="{Binding FiltroAlmacenesTexto, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DescripcionCombo"
                              Style="{StaticResource EstiloComboBox}" Height="30"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              IsDropDownOpen="{Binding IsDropDownOpenAlmacenes}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding AbrirDropDownAlmacenesCommand}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CerrarDropDownAlmacenesCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <!-- Almacén Origen -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Almacén Origen:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" 
                              ItemsSource="{Binding AlmacenesOrigenComboView}"
                              SelectedItem="{Binding AlmacenOrigenSeleccionado}"
                              Text="{Binding FiltroAlmacenesOrigenTexto, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DescripcionCombo"
                              Style="{StaticResource EstiloComboBox}" Height="30"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              IsDropDownOpen="{Binding IsDropDownOpenAlmacenesOrigen}"
                              Margin="0,10,0,0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding AbrirDropDownAlmacenesOrigenCommand}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CerrarDropDownAlmacenesOrigenCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <!-- Fecha desde -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fecha desde:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding FechaDesde}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200" Margin="0,10,0,0"/>

                    <!-- Fecha hasta -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha hasta:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding FechaHasta}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200" Margin="0,10,0,0"/>

                    <!-- Fecha Plan -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Fecha Plan:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding FechaPlan}" Style="{StaticResource EstiloDatePicker}" Height="30" Width="200" Margin="0,10,0,0"/>

                    <!-- Estado -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Estado:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" 
                              ItemsSource="{Binding EstadosCombo}"
                              SelectedItem="{Binding EstadoFiltro}"
                              Style="{StaticResource EstiloComboBox}" Height="30" Width="200" Margin="0,10,0,0"/>

                    <!-- Prioridad -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Prioridad:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" 
                              ItemsSource="{Binding PrioridadesCombo}"
                              SelectedItem="{Binding PrioridadFiltro}"
                              Style="{StaticResource EstiloComboBox}" Height="30" Width="200" Margin="0,10,0,0"/>

                    <!-- Código Orden -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Código Orden:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Text="{Binding CodigoOrdenFiltro, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontFamily="Consolas"
                             FontSize="14"
                             Padding="4,2"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushInputBorde}"
                             Background="White"
                             Margin="0,10,0,0"/>

                    <!-- Operario -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Operario:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <ComboBox Grid.Row="8" Grid.Column="1" 
                              ItemsSource="{Binding OperariosComboView}"
                              DisplayMemberPath="NombreOperario"
                              SelectedItem="{Binding OperarioSeleccionadoCombo}"
                              Text="{Binding FiltroOperariosCombo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsDropDownOpen="{Binding IsDropDownOpenCombo}"
                              Style="{StaticResource EstiloComboBox}" Height="30" Width="200"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              MaxDropDownHeight="200"
                              Margin="0,10,0,0">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding CerrarDropDownComboCommand}"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding AbrirDropDownComboCommand}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <!-- Creador -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Creador:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,10,15,0"/>
                    <ComboBox Grid.Row="9" Grid.Column="1" 
                              ItemsSource="{Binding UsuariosCombo}"
                              DisplayMemberPath="NombreUsuario"
                              SelectedValue="{Binding CreadorSeleccionado}"
                              SelectedValuePath="UsuarioId"
                              Style="{StaticResource EstiloComboBox}" Height="30" Width="200" Margin="0,10,0,0"/>

                    <!-- Ver todas las órdenes -->
                    <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                             Content="Ver todas las órdenes (no solo las propias)"
                             IsChecked="{Binding VerTodasLasOrdenes}"
                             Margin="0,15,0,0"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>

            <!-- Botones: Aplicar, Limpiar, Cancelar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Aplicar" 
                        Command="{Binding AplicarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}" 
                        Width="100" Height="35" Margin="0,0,8,0"/>
                <Button Content="Limpiar" 
                        Command="{Binding LimpiarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Width="100" Height="35" Margin="0,0,8,0"/>
                <Button Content="Cancelar" 
                        IsCancel="True" 
                        Command="{Binding CerrarCommand}" 
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Width="100" Height="35"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

