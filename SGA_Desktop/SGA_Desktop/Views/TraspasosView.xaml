<Page x:Class="SGA_Desktop.Views.TraspasosView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SGA_Desktop.ViewModels"
      xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
      Title="Gestión de Traspasos">

    <!-- DataContext -->
    <Page.DataContext>
        <vm:TraspasosViewModel />
    </Page.DataContext>

    <!-- Recursos -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:NullToBoolConverter x:Key="NotNullToBoolConverter"/>
            <helpers:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
            <helpers:OperarioIdANombreConverter x:Key="OperarioIdANombreConverter"/>
            <helpers:EstaAbiertoConverter x:Key="EstaAbiertoConverter"/>
            <helpers:EstaCerradoConverter x:Key="EstaCerradoConverter"/>
            <helpers:EstadoColorConverter x:Key="EstadoColorConverter"/>
            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <helpers:UbicacionConverter x:Key="UbicacionConverter"/>
            <helpers:TipoBloqueoDisplayConverter x:Key="TipoBloqueoDisplayConverter"/>
            <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource BrushFondo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE HERRAMIENTAS UNIFICADA -->
        <Border Grid.Row="0" 
                Background="{StaticResource BrushPrincipal}"
                Padding="20,15"
                BorderBrush="{StaticResource BrushInputBorde}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="📦 Gestión de Palets y Traspasos"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>

                <!-- Controles -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{Binding TextoBotonErrores}"
                            Command="{Binding MostrarTraspasosErrorCommand}"
                            Width="140"
                            Height="35"
                            Margin="0,0,10,0"
                            Visibility="{Binding BotonErroresVisibility}"
                            ToolTip="{Binding TextoBotonErrores}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonPrincipal}">
                                <Setter Property="Background" Value="#D7263D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#D7263D"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostrandoErrores}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding TextoBotonPendientes}"
                            Command="{Binding MostrarPaletsPendientesCommand}"
                            Width="170"
                            Height="35"
                            Margin="0,0,10,0"
                            Visibility="{Binding BotonPendientesVisibility}"
                            ToolTip="{Binding TextoBotonPendientes}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonPrincipal}">
                                <Setter Property="Background" Value="#1F1F1F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#1F1F1F"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostrandoPendientesVaciado}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#1F1F1F"/>
                                        <Setter Property="BorderBrush" Value="#1F1F1F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="🔍 Filtros"
                            Command="{Binding AbrirFiltrosCommand}"
                            Width="100"
                            Height="35"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Content="➕ Nuevo"
                            Command="{Binding CrearPaletCommand}"
                            Width="100"
                            Height="35"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Button.Style>
                    </Button>


                    <Button Content="🔄 Recargar"
                            Command="{Binding LoadPaletsCommand}"
                            Width="100"
                            Height="35">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Lista de palets en formato cards - Pantalla completa -->
            <GroupBox Grid.Row="0" Header="📦 Palets Disponibles" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PaletsView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EstiloTarjeta}"
                                        Width="380"
                                        Height="380"
                                        Margin="8"
                                        Cursor="Hand">
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource EstiloContextMenu}">
                                            <MenuItem Header="Copiar código palet"
                                                      Style="{StaticResource EstiloMenuItem}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarCodigoPaletCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="Codigo" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar estado"
                                                      Style="{StaticResource EstiloMenuItem}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarEstadoPaletCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="Estado" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar tipo palet"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding TipoPaletCodigo, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarTipoPaletCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="TipoPaletCodigo" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Copiar fecha apertura"
                                                      Style="{StaticResource EstiloMenuItem}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarFechaAperturaCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="FechaApertura"/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar usuario apertura"
                                                      Style="{StaticResource EstiloMenuItem}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarUsuarioAperturaCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="UsuarioAperturaNombre" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar fecha cierre"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding FechaCierre, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarFechaCierreCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="FechaCierre"/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar usuario cierre"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding UsuarioCierreNombre, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarUsuarioCierreCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="UsuarioCierreNombre" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Copiar orden trabajo"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding OrdenTrabajoId, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarOrdenTrabajoCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="OrdenTrabajoId" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar almacén"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding AlmacenOrigen, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarAlmacenOrigenPaletCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="AlmacenOrigen" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar ubicación"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding UbicacionOrigen, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarUbicacionOrigenPaletCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="UbicacionOrigen" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar fecha último traspaso"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding FechaUltimoTraspaso, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarFechaUltimoTraspasoCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="FechaUltimoTraspaso"/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Copiar tipo última actividad"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding TipoUltimaActividad, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarTipoUltimaActividadCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="TipoUltimaActividad" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar fecha última actividad"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding FechaUltimaActividad, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarFechaUltimaActividadCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="FechaUltimaActividad"/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar usuario última actividad"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding UsuarioUltimaActividadNombre, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarUsuarioUltimaActividadCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="UsuarioUltimaActividadNombre" TargetNullValue=""/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Copiar peso"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding Peso, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarPesoCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="Peso"/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Copiar altura"
                                                      Style="{StaticResource EstiloMenuItem}"
                                                      Visibility="{Binding Altura, Converter={StaticResource NullToVisibilityConverter}}">
                                                <MenuItem.Command>
                                                    <Binding Path="Data.CopiarAlturaCommand" Source="{StaticResource VmProxy}"/>
                                                </MenuItem.Command>
                                                <MenuItem.CommandParameter>
                                                    <Binding Path="Altura"/>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid MouseLeftButtonDown="PaletCard_MouseLeftButtonDown" Tag="{Binding}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header con Código y Estado -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Código -->
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                    <TextBlock Text="Código: "
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource BrushPrincipal}"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Codigo}"
                                                               FontFamily="Consolas"
                                                               FontWeight="Bold"
                                                               Foreground="#2C3E50"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <!-- 🔷 NUEVO: Badge de bloqueo por calidad -->
                                                <Border Background="#FF6B6B" 
                                                        CornerRadius="3" 
                                                        Padding="6,3" 
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding TieneArticulosBloqueadosCalidad, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="Palet contiene artículos bloqueados por calidad" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding CantidadArticulosBloqueados, StringFormat='Artículos bloqueados: {0}'}" 
                                                                           Margin="0,2,0,0"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding MotivoBloqueoCalidad}" 
                                                                           Visibility="{Binding MotivoBloqueoCalidad, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                           Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding FechaBloqueoCalidad, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}" 
                                                                           Visibility="{Binding FechaBloqueoCalidad, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding CantidadArticulosBloqueados, StringFormat='BLOQUEADO CALIDAD ({0})'}" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Indicador de estado -->
                                            <Border Grid.Column="1"
                                                    Background="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                                    BorderBrush="{Binding Estado, Converter={StaticResource EstadoColorConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="8,4"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Estado}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Contenido principal -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <!-- Mensaje de error ERP -->
                                            <Border Background="#FFE5E9"
                                                    BorderBrush="#D7263D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding ErrorErpMensaje, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding ErrorErpMensaje}"
                                                           Foreground="#D7263D"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                            </Border>

                                            <Border Background="#1B1F23"
                                                    BorderBrush="#1B1F23"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding MensajePendienteVaciado, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Border.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="Detalle de líneas sin stock" FontWeight="Bold"/>
                                                            <ItemsControl ItemsSource="{Binding LineasPendientesVaciado}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock FontSize="11" Foreground="#333" TextWrapping="Wrap">
                                                                            <Run Text="{Binding CodigoArticulo}"/>
                                                                            <Run Text=" - "/>
                                                                            <Run Text="{Binding Lote, TargetNullValue='Sin lote'}"/>
                                                                            <Run Text=" - "/>
                                                                            <Run Text="{Binding CodigoAlmacen}"/>
                                                                            <Run Text="/"/>
                                                                            <Run Text="{Binding Ubicacion}"/>
                                                                            <Run Text=" - "/>
                                                                            <Run Text="{Binding CantidadFaltante, StringFormat={}{0:F6}}"/>
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MensajePendienteVaciado}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding LineasPendientesVaciado.Count, StringFormat='Líneas afectadas: {0}'}"
                                                               Foreground="#E0E0E0"
                                                               FontSize="11"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Fecha de apertura -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Apertura: "
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FechaApertura, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#34495E"/>
                                            </Grid>

                                            <!-- Usuario apertura -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Abre: "
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding UsuarioAperturaNombre}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#34495E"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Fecha de cierre (si existe) -->
                                            <Grid Margin="0,0,0,8"
                                                  Visibility="{Binding UsuarioCierreNombre, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Cierre: "
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FechaCierre, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#34495E"/>
                                            </Grid>

                                            <!-- Usuario cierre (si existe) -->
                                            <Grid Margin="0,0,0,8"
                                                  Visibility="{Binding UsuarioCierreNombre, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Cierra: "
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding UsuarioCierreNombre}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#34495E"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>

                                            <!-- Orden de trabajo -->
                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding OrdenTrabajoId, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="📄 Orden: "
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding OrdenTrabajoId}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushPrincipal}"/>
                                            </Grid>

                                            <!-- Peso y altura (si existen) -->
                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding Peso, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="⚖️ Peso: "
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Peso, StringFormat='{}{0:F2} kg'}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#34495E"/>

                                                <TextBlock Grid.Column="2" Text="📏 Altura: "
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#7F8C8D"
                                                           Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Altura, StringFormat='{}{0:F2} cm'}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#34495E"/>
                                            </Grid>

                                            <!-- Información de traspaso (si existe) -->
                                            <Grid Margin="0,8,0,0"
                                                  Visibility="{Binding AlmacenOrigen, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="🏢 Almacén: "
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AlmacenOrigen}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#34495E"/>

                                                <TextBlock Grid.Column="2" Text="📍 Ubicación: "
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#7F8C8D"
                                                           Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding UbicacionOrigen, Converter={StaticResource UbicacionConverter}}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#34495E"/>
                                            </Grid>

                                            <!-- Fecha último traspaso (si existe) -->
                                            <Grid Margin="0,4,0,0"
                                                  Visibility="{Binding FechaUltimoTraspaso, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="🕒 Último traspaso: "
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="#7F8C8D"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FechaUltimoTraspaso, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#34495E"/>
                                            </Grid>

                                            <!-- 🔷 NUEVO: Información de última actividad -->
                                            <Border Margin="0,8,0,0"
                                                    Padding="8"
                                                    CornerRadius="6"
                                                    Background="#F8F9FA"
                                                    BorderBrush="{Binding TipoUltimaActividad, Converter={StaticResource EstadoColorConverter}}"
                                                    BorderThickness="2"
                                                    Visibility="{Binding TipoUltimaActividad, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Tipo de actividad con icono -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="🔄 Última actividad: "
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Foreground="#7F8C8D"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <!-- Icono según tipo de actividad -->
                                                            <TextBlock FontSize="12" Margin="0,0,4,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="📦"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TipoUltimaActividad}" Value="CIERRE">
                                                                                <Setter Property="Text" Value="🔒"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TipoUltimaActividad}" Value="TRASPASO">
                                                                                <Setter Property="Text" Value="🚚"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TipoUltimaActividad}" Value="ERROR ERP">
                                                                                <Setter Property="Text" Value="⚠️"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Background="{Binding TipoUltimaActividad, Converter={StaticResource EstadoColorConverter}}"
                                                                    CornerRadius="3"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TipoUltimaActividad}"
                                                                           FontWeight="Bold"
                                                                           FontSize="10"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Fecha y usuario de última actividad -->
                                                    <StackPanel Grid.Row="1">
                                                        <!-- Fecha -->
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="📅 Fecha: "
                                                                       FontWeight="SemiBold"
                                                                       FontSize="10"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FechaUltimaActividad, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                                       FontWeight="Bold"
                                                                       FontSize="10"
                                                                       Foreground="#34495E"/>
                                                        </Grid>

                                                        <!-- Usuario -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="👤 Usuario: "
                                                                       FontWeight="SemiBold"
                                                                       FontSize="10"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding UsuarioUltimaActividadNombre}"
                                                                       FontWeight="Bold"
                                                                       FontSize="10"
                                                                       Foreground="#34495E"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <!-- Botones de acción -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="👁️ Ver"
                                                    Command="{Binding DataContext.SeleccionarPaletCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource EstiloBotonPrincipal}"
                                                    Width="60"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0"/>

                                            <Button Content="🗑️ Vaciar"
                                                    Command="{Binding DataContext.VaciarPaletPendienteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Width="80"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonPrincipal}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Background" Value="#1B1F23"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#1B1F23"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="🔁 Relanzar"
                                                    Command="{Binding DataContext.RelanzarTraspasoErrorCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Width="90"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonPrincipal}">
                                                        <Setter Property="Background" Value="#D7263D"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#D7263D"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TraspasoErrorId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="📦 Añadir"
                                                    Click="AbrirPaletLineas_Click"
                                                    Tag="{Binding}"
                                                    Width="70"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TraspasoErrorId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Cerrado">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="🔒 Cerrar"
                                                    Click="CerrarPalet_Click"
                                                    Tag="{Binding}"
                                                    Width="70"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonPrincipal}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Estado}" Value="Abierto"/>
                                                                    <Condition Binding="{Binding TraspasoErrorId}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="🔓 Abrir"
                                                    Click="ReabrirPalet_Click"
                                                    Tag="{Binding}"
                                                    Width="70"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Estado}" Value="Cerrado"/>
                                                                    <Condition Binding="{Binding TraspasoErrorId}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="🚚 Traspasar"
                                                    Click="TraspasarPalet_Click"
                                                    Tag="{Binding}"
                                                    Width="80"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonPrincipal}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Estado}" Value="Cerrado"/>
                                                                    <Condition Binding="{Binding TraspasoErrorId}" Value="{x:Null}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="🖨️ Imprimir"
                                                    Click="ImprimirPalet_Click"
                                                    Tag="{Binding}"
                                                    Width="70"
                                                    Height="30"
                                                    FontSize="10"
                                                    FontWeight="Medium">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TraspasoErrorId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EsPendienteVaciado}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <!-- Sección expandible para contenido del palet -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushPrincipal}"
                    Padding="20,15"
                    BorderBrush="{StaticResource BrushInputBorde}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding PaletSeleccionado, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del contenido -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding PaletSeleccionado.Codigo, StringFormat='Contenido del palet: {0}'}"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="✕ Cerrar"
                                Width="80"
                                Height="30"
                                Command="{Binding CerrarContenidoCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Contenido del palet -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="6"
                            Padding="15"
                            MaxHeight="300">
                        <StackPanel>
                            <TextBlock Text="Líneas del palet seleccionado:" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding LineasPalet}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" 
                                                    BorderBrush="#B0B0B0" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="12" 
                                                    Margin="4"
                                                    Width="300"
                                                    MinHeight="120">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <!-- 🔷 NUEVO: Bloqueo por calidad -->
                                                            <DataTrigger Binding="{Binding IsBloqueadoCalidad}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                                                </Border.Effect>
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource EstiloContextMenu}">
                                                        <MenuItem Header="Copiar código artículo"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarCodigoCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="CodigoArticulo" TargetNullValue=""/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                        <MenuItem Header="Copiar descripción"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarDescripcionCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="DescripcionArticulo" TargetNullValue=""/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Copiar almacén"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarAlmacenCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="CodigoAlmacen" TargetNullValue=""/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                        <MenuItem Header="Copiar ubicación"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarUbicacionCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="Ubicacion" TargetNullValue=""/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Copiar lote"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarLoteCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="Lote" TargetNullValue=""/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                        <MenuItem Header="Copiar fecha caducidad"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarFechaCaducidadCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="FechaCaducidad"/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Copiar cantidad"
                                                                  Style="{StaticResource EstiloMenuItem}">
                                                            <MenuItem.Command>
                                                                <Binding Path="Data.CopiarCantidadCommand" Source="{StaticResource VmProxy}"/>
                                                            </MenuItem.Command>
                                                            <MenuItem.CommandParameter>
                                                                <Binding Path="Cantidad"/>
                                                            </MenuItem.CommandParameter>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Header con código del artículo -->
                                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding CodigoArticulo}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource BrushPrincipal}"/>
                                                            
                                                            <!-- 🔷 NUEVO: Indicador de bloqueo por calidad -->
                                                            <Border Background="#FF6B6B" 
                                                                    CornerRadius="3" 
                                                                    Padding="4,2" 
                                                                    Margin="8,0,0,0"
                                                                    Visibility="{Binding IsBloqueadoCalidad, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <Border.ToolTip>
                                                                    <ToolTip>
                                                                        <StackPanel>
                                                                            <TextBlock Text="Artículo bloqueado por calidad" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding MotivoBloqueoCalidad}" 
                                                                                       Visibility="{Binding MotivoBloqueoCalidad, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                            <TextBlock Text="{Binding FechaBloqueoCalidad, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}" 
                                                                                       Visibility="{Binding FechaBloqueoCalidad, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </Border.ToolTip>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🔒" FontSize="10" Margin="0,0,2,0"/>
                                                                    <TextBlock FontSize="8" 
                                                                               FontWeight="Bold" 
                                                                               Foreground="White">
                                                                        <Run Text="BLOQUEADO"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding TipoBloqueoCalidad, Converter={StaticResource TipoBloqueoDisplayConverter}, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        
                                                        <TextBlock Text="{Binding DescripcionArticulo}" 
                                                                   FontSize="11" 
                                                                   Foreground="#666"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="32"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Información del artículo -->
                                                    <StackPanel Grid.Row="1">
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <TextBlock Grid.Column="0" Text="Almacén:" FontWeight="SemiBold" FontSize="10" Foreground="#888"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CodigoAlmacen}" FontSize="10" Margin="4,0,15,0"/>
                                                            
                                                            <TextBlock Grid.Column="2" Text="Ubicación:" FontWeight="SemiBold" FontSize="10" Foreground="#888"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Ubicacion}" FontSize="10" Margin="4,0,0,0"/>
                                                        </Grid>
                                                        
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <TextBlock Grid.Column="0" Text="Lote:" FontWeight="SemiBold" FontSize="10" Foreground="#888"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Lote}" FontSize="10" Margin="4,0,15,0"/>
                                                            
                                                            <TextBlock Grid.Column="2" Text="Caducidad:" FontWeight="SemiBold" FontSize="10" Foreground="#888"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding FechaCaducidad, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="10" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                    
                                                    <!-- Cantidad -->
                                                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                                        <TextBlock Text="Cantidad:" 
                                                                   FontSize="10" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="#888"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,4"/>
                                                        <Border Background="{StaticResource BrushPrincipal}" 
                                                                CornerRadius="4" 
                                                                Padding="8,4">
                                                            <TextBlock Text="{Binding Cantidad}" 
                                                                       FontSize="14" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de estado general -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushPrincipal}"
                Padding="20,10"
                BorderBrush="{StaticResource BrushInputBorde}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Mensaje}"
                           VerticalAlignment="Center"
                           Foreground="White"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding Cargando, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Width="100"
                                 Height="15"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="Cargando..."
