<Page x:Class="SGA_Desktop.Views.RendimientosView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SGA_Desktop.ViewModels"
      xmlns:models="clr-namespace:SGA_Desktop.Models"
      xmlns:oxy="http://oxyplot.org/wpf"
      xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
      Title="Análisis de Rendimientos"
      Background="{StaticResource BrushFondo}">
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:PorcentajeDistribucionConverter x:Key="PorcentajeDistribucionConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Filtros -->
            <RowDefinition Height="Auto"/> <!-- Pestañas -->
            <RowDefinition Height="*"/> <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Panel de Filtros -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="{StaticResource BrushPrincipal}"
                BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="FILTROS:" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,15,0"
                           Foreground="{StaticResource BrushPrincipal}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Fecha Desde" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FechaDesde}" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Fecha Hasta" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FechaHasta}" Width="150"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Aplicar Filtros" 
                            Command="{Binding AplicarFiltrosCommand}"
                            Style="{StaticResource EstiloBotonPrincipal}"
                            Margin="0,0,10,0"
                            Padding="15,8"/>
                    <Button Content="Limpiar" 
                            Command="{Binding LimpiarFiltrosCommand}"
                            Style="{StaticResource EstiloBotonPrincipal}"
                            Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOTONES DE PESTAÑAS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="👤 Operarios"
                    Command="{Binding CambiarAOperariosCommand}"
                    Width="140"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoOperarios}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📦 Volumen Movido"
                    Command="{Binding CambiarAVolumenCommand}"
                    Width="160"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoVolumen}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📍 Distribución"
                    Command="{Binding CambiarADistribucionCommand}"
                    Width="140"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoDistribucion}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📋 Artículos"
                    Command="{Binding CambiarAArticulosCommand}"
                    Width="120"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoArticulos}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="⚡ Eficiencia"
                    Command="{Binding CambiarAEficienciaCommand}"
                    Width="120"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoEficiencia}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📈 Tendencias"
                    Command="{Binding CambiarATendenciasCommand}"
                    Width="130"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoTendencias}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📊 Comparativas"
                    Command="{Binding CambiarAComparativasCommand}"
                    Width="150"
                    Height="35">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoComparativas}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Contenido según Pestaña -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="8" 
                Padding="15"
                BorderBrush="{StaticResource BrushPrincipal}"
                BorderThickness="2">
            <Grid>
                <!-- Operarios - Lista Expandible -->
                <Grid Visibility="{Binding MostrandoOperarios, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filtros y ordenación -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource BrushPrincipal}"
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Buscar:" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"
                                       FontWeight="SemiBold"/>
                            
                            <TextBox Grid.Column="1" 
                                     Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,20,0"/>
                            
                            <TextBlock Grid.Column="2" 
                                       Text="Ordenar por:" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"
                                       FontWeight="SemiBold"/>
                            
                            <ComboBox Grid.Column="3" 
                                      SelectedValue="{Binding CriterioOrdenacion}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Total Operaciones" Tag="TotalOperaciones"/>
                                <ComboBoxItem Content="Traspasos Completados" Tag="TraspasosCompletados"/>
                                <ComboBoxItem Content="Tiempo Promedio" Tag="TiempoPromedio"/>
                                <ComboBoxItem Content="Traspasos/Día" Tag="TraspasosPorDia"/>
                                <ComboBoxItem Content="Ranking" Tag="Ranking"/>
                                <ComboBoxItem Content="Nombre" Tag="Nombre"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Operarios}" Margin="0,5,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="6" 
                                        Padding="0"
                                        Margin="0,0,0,8"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BrushIntermedio}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Badge de Ranking -->
                                                <Border Grid.Column="0" 
                                                        Background="#FFD700" 
                                                        CornerRadius="3" 
                                                        Padding="6,2" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#DAA520"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ranking}" Value="1">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🥇 TOP 1" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#2C2C2C"/>
                                                </Border>
                                                <Border Grid.Column="0" 
                                                        Background="#C0C0C0" 
                                                        CornerRadius="3" 
                                                        Padding="6,2" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#A0A0A0"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ranking}" Value="2">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🥈 TOP 2" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#2C2C2C"/>
                                                </Border>
                                                <Border Grid.Column="0" 
                                                        Background="#CD7F32" 
                                                        CornerRadius="3" 
                                                        Padding="6,2" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#A0522D"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ranking}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🥉 TOP 3" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#2C2C2C"/>
                                                </Border>
                                                
                                                <!-- Nombre -->
                                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NombreOperario}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="{StaticResource BrushPrincipal}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Ranking: #" 
                                                                   FontSize="10" 
                                                                   Foreground="Gray"/>
                                                        <TextBlock Text="{Binding Ranking}" 
                                                                   FontSize="10" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="Gray"/>
                                                        <TextBlock Text=" | " 
                                                                   FontSize="10" 
                                                                   Foreground="Gray" 
                                                                   Margin="3,0"/>
                                                        <TextBlock FontSize="10" 
                                                                   Foreground="Gray">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F1}% del total">
                                                                    <Binding Path="PorcentajeDelTotal"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Total Operaciones -->
                                                <StackPanel Grid.Column="2" 
                                                            Orientation="Vertical" 
                                                            Margin="20,0,15,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Total" 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding TotalOperaciones}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black"/>
                                                </StackPanel>
                                                
                                                <!-- Traspasos -->
                                                <StackPanel Grid.Column="3" 
                                                            Orientation="Vertical" 
                                                            Margin="0,0,15,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Traspasos" 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding TraspasosCompletados}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black"/>
                                                    <TextBlock FontSize="9" 
                                                               Foreground="Gray">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F1}/día">
                                                                <Binding Path="TraspasosPorDia"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- Tiempo Promedio -->
                                                <StackPanel Grid.Column="4" 
                                                            Orientation="Vertical" 
                                                            Margin="0,0,15,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Tiempo Prom." 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F1} min">
                                                                <Binding Path="TiempoPromedioTraspasosMinutos"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" 
                                                               Foreground="Gray"
                                                               Visibility="{Binding VariacionPorcentual, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:+#0.0;-#0.0;0}% vs promedio">
                                                                <Binding Path="VariacionPorcentual"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- Indicador de actividad -->
                                                <StackPanel Grid.Column="5" 
                                                            Orientation="Vertical" 
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Días Activos" 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding DiasActivos}" 
                                                               FontSize="14" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="Black"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        
                                        <!-- Contenido expandido -->
                                        <Grid Margin="15,10,15,15">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Métricas de Traspasos -->
                                            <GroupBox Header="Traspasos" 
                                                      Grid.Row="0" 
                                                      Margin="0,0,0,10"
                                                      FontSize="12"
                                                      FontWeight="Bold">
                                                <Grid Margin="10,10,10,5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Primera fila: Tipos de traspasos -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Traspasos Palet" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding TraspasosPalet}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Traspasos Artículo" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding TraspasosArticulo}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Tasa Finalización" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1}%">
                                                                        <Binding Path="TasaFinalizacion"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                    
                                                    <!-- Segunda fila: Tiempos -->
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Tiempo Promedio" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoPromedioTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Tiempo Mediano" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoMedianoTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Más Rápido" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#4CAF50">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoMinimoTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="Más Lento" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#F44336">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoMaximoTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </GroupBox>
                                            
                                            <!-- Distribución -->
                                            <GroupBox Header="Distribución" 
                                                      Grid.Row="1" 
                                                      Margin="0,0,0,10"
                                                      FontSize="12"
                                                      FontWeight="Bold">
                                                <Grid Margin="10,10,10,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Almacenes Diferentes" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding AlmacenesDiferentes}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Artículos Diferentes" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding ArticulosDiferentes}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Última Actividad" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                        <TextBlock FontSize="14" FontWeight="SemiBold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:dd/MM/yyyy HH:mm}">
                                                                    <Binding Path="UltimaActividad"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </GroupBox>
                                            
                                            <!-- Métricas de Inventarios y Conteos -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Inventarios -->
                                                <GroupBox Header="Inventarios" 
                                                          Grid.Column="0" 
                                                          Margin="0,0,5,0"
                                                          FontSize="12"
                                                          FontWeight="Bold">
                                                    <Grid Margin="10,10,10,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                            <TextBlock Text="Líneas Generadas" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding LineasInventarioGeneradas}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                            <TextBlock Text="Líneas Contadas" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding LineasInventarioContadas}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                                            <TextBlock Text="Líneas Creadas" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding LineasInventarioCreadas}" FontSize="14" FontWeight="SemiBold" Foreground="#E67E22"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="3">
                                                            <TextBlock Text="Líneas/Hora" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1}">
                                                                        <Binding Path="LineasPorHora"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </GroupBox>
                                                
                                                <!-- Conteos -->
                                                <GroupBox Header="Conteos" 
                                                          Grid.Column="1" 
                                                          Margin="5,0,0,0"
                                                          FontSize="12"
                                                          FontWeight="Bold">
                                                    <Grid Margin="10,10,10,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                            <TextBlock Text="Lecturas" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding LecturasConteo}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                            <TextBlock Text="Completados" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding ConteosCompletados}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="Tiempo Promedio" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoPromedioConteoMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </GroupBox>
                                            </Grid>
                                        </Grid>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Volumen Movido -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding MostrandoVolumen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Tarjetas de métricas -->
                            <RowDefinition Height="Auto"/> <!-- Desglose por tipo -->
                            <RowDefinition Height="Auto"/> <!-- Evolución temporal -->
                            <RowDefinition Height="Auto"/> <!-- Top artículos -->
                        </Grid.RowDefinitions>

                        <!-- Tarjetas de Métricas Principales -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Unidades Movidas -->
                            <Border Grid.Column="0" 
                                    Background="White" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="0,0,10,0"
                                    BorderBrush="{StaticResource BrushPrincipal}"
                                    BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="Unidades Movidas" 
                                               FontSize="12" 
                               Foreground="Gray"
                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource BrushPrincipal}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N2}">
                                                <Binding Path="VolumenMovido.TotalUnidadesMovidas"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="10" 
                                               Foreground="Green"
                                               Visibility="{Binding VolumenMovido.ComparativaPeriodoAnterior.VariacionUnidades, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:+#0.0;-#0.0;0}% vs período anterior">
                                                <Binding Path="VolumenMovido.ComparativaPeriodoAnterior.VariacionUnidades"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Valor Económico -->
                            <Border Grid.Column="1" 
                                    Background="White" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="0,0,10,0"
                                    BorderBrush="{StaticResource BrushPrincipal}"
                                    BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="Valor Económico" 
                               FontSize="12" 
                               Foreground="Gray"
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource BrushPrincipal}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:C2}">
                                                <Binding Path="VolumenMovido.TotalValorEconomico"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="10" 
                                               Foreground="Green"
                                               Visibility="{Binding VolumenMovido.ComparativaPeriodoAnterior.VariacionValor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:+#0.0;-#0.0;0}% vs período anterior">
                                                <Binding Path="VolumenMovido.ComparativaPeriodoAnterior.VariacionValor"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Palets Únicos -->
                            <Border Grid.Column="2" 
                                    Background="White" 
                                    CornerRadius="8" 
                                    Padding="15" 
                                    Margin="0,0,10,0"
                                    BorderBrush="{StaticResource BrushPrincipal}"
                                    BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="Palets Únicos" 
                               FontSize="12" 
                               Foreground="Gray"
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource BrushPrincipal}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0}">
                                                <Binding Path="VolumenMovido.TotalPaletsUnicos"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="10" 
                                               Foreground="Green"
                                               Visibility="{Binding VolumenMovido.ComparativaPeriodoAnterior.VariacionPalets, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:+#0.0;-#0.0;0}% vs período anterior">
                                                <Binding Path="VolumenMovido.ComparativaPeriodoAnterior.VariacionPalets"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Kilos Movidos (opcional) -->
                            <Border Grid.Column="3" 
                                    Background="White" 
                                    CornerRadius="8" 
                                    Padding="15"
                                    BorderBrush="{StaticResource BrushPrincipal}"
                                    BorderThickness="2"
                                    Visibility="{Binding VolumenMovido.TotalKilosMovidos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Kilos Movidos" 
                               FontSize="12" 
                               Foreground="Gray"
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource BrushPrincipal}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N2} kg">
                                                <Binding Path="VolumenMovido.TotalKilosMovidos"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Desglose por Tipo -->
                        <GroupBox Header="Desglose por Tipo de Traspaso" 
                                  Grid.Row="1" 
                                  Margin="0,0,0,20"
                                  FontSize="14"
                                  FontWeight="Bold">
                            <Grid Margin="10,10,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Traspasos Palet -->
                                <Border Grid.Column="0" 
                                        Background="#F5F5F5" 
                                        CornerRadius="6" 
                                        Padding="15" 
                                        Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Traspasos de Palet" 
                                                   FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrincipal}"
                               Margin="0,0,0,10"/>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Unidades" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N2}">
                                                        <Binding Path="VolumenMovido.DesglosePorTipo.UnidadesPalet"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Valor" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:C2}">
                                                        <Binding Path="VolumenMovido.DesglosePorTipo.ValorPalet"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Cantidad" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding VolumenMovido.DesglosePorTipo.CantidadTraspasosPalet}" 
                                                       FontSize="16" 
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Traspasos Artículo -->
                                <Border Grid.Column="1" 
                                        Background="#F5F5F5" 
                                        CornerRadius="6" 
                                        Padding="15" 
                                        Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Traspasos de Artículo" 
                               FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource BrushPrincipal}"
                                                   Margin="0,0,0,10"/>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Unidades" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N2}">
                                                        <Binding Path="VolumenMovido.DesglosePorTipo.UnidadesArticulo"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="Valor" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:C2}">
                                                        <Binding Path="VolumenMovido.DesglosePorTipo.ValorArticulo"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Cantidad" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding VolumenMovido.DesglosePorTipo.CantidadTraspasosArticulo}" 
                                                       FontSize="16" 
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <!-- Evolución Temporal -->
                        <GroupBox Header="Evolución Temporal" 
                                  Grid.Row="2" 
                                  Margin="0,0,0,20"
                                  FontSize="14"
                                  FontWeight="Bold">
                            <Grid Margin="10,10,10,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <oxy:PlotView Grid.Row="0"
                                              Model="{Binding PlotModelEvolucion}" 
                                              Height="300"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                                
                                <!-- Leyenda manual -->
                                <StackPanel Grid.Row="1" 
                                            Orientation="Horizontal" 
                               HorizontalAlignment="Center"
                                            Margin="0,10,0,5">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <Ellipse Width="12" Height="12" Fill="Blue" Margin="0,0,5,0"/>
                                        <TextBlock Text="Unidades - Traspasos Palet" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Fill="Orange" Margin="0,0,5,0"/>
                                        <TextBlock Text="Unidades - Traspasos Artículo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Tabla de datos debajo del gráfico (opcional) -->
                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding VolumenMovido.EvolucionTemporal}" 
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="All"
                                          HeadersVisibility="Column"
                                          Margin="0,10,0,0"
                                          MaxHeight="150"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                                        <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="Auto"/>
                                        <DataGridTextColumn Header="Unidades Palet" Binding="{Binding UnidadesPalet, StringFormat=N2}" Width="Auto"/>
                                        <DataGridTextColumn Header="Unidades Artículo" Binding="{Binding UnidadesArticulo, StringFormat=N2}" Width="Auto"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Unidades, StringFormat=N2}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- Top Artículos -->
                        <GroupBox Header="Top 10 Artículos Más Movidos" 
                                  Grid.Row="3"
                                  FontSize="14"
                                  FontWeight="Bold">
                            <ItemsControl ItemsSource="{Binding VolumenMovido.TopArticulos}" 
                                          Margin="10,10,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                CornerRadius="6" 
                                                Padding="12"
                                                Margin="0,0,0,8"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource BrushIntermedio}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Posicion}" 
                                                           FontSize="18" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrincipal}"
                                                           Margin="0,0,15,0"
                                                           VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CodigoArticulo}" 
                                                               FontSize="14" 
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DescripcionArticulo}" 
                                                               FontSize="11" 
                                                               Foreground="Gray"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="2" 
                                                           FontSize="14" 
                                                           FontWeight="SemiBold"
                                                           Margin="20,0,20,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:N2} unidades">
                                                            <Binding Path="UnidadesMovidas"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                
                                                <TextBlock Grid.Column="3" 
                               FontSize="12" 
                               Foreground="Gray"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F1}%">
                                                            <Binding Path="PorcentajeDelTotal"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>

                <!-- Distribución -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding MostrandoDistribucion, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Pestañas de vista -->
                            <RowDefinition Height="Auto"/> <!-- Top Almacenes -->
                            <RowDefinition Height="Auto"/> <!-- Top Ubicaciones -->
                            <RowDefinition Height="Auto"/> <!-- Flujos Principales -->
                        </Grid.RowDefinitions>

                        <!-- Pestañas para alternar entre vista por Unidades y por Traspasos -->
                        <StackPanel Grid.Row="0" 
                                    Orientation="Horizontal" 
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center">
                            <Button Content="Por Unidades" 
                                    Padding="20,10"
                                    Margin="0,0,10,0"
                                    Command="{Binding CambiarVistaDistribucionCommand}"
                                    CommandParameter="Unidades"
                                    Style="{StaticResource EstiloBotonPrincipal}"
                                    IsEnabled="{Binding DistribucionPorUnidades, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="Por Nº Traspasos" 
                                    Padding="20,10"
                                    Command="{Binding CambiarVistaDistribucionCommand}"
                                    CommandParameter="Traspasos"
                                    Style="{StaticResource EstiloBotonPrincipal}"
                                    IsEnabled="{Binding DistribucionPorUnidades}"/>
                        </StackPanel>

                        <!-- Top Almacenes -->
                        <GroupBox Header="Top 10 Almacenes" 
                                  Grid.Row="1" 
                                  Margin="0,0,0,20"
                                  FontSize="14"
                                  FontWeight="Bold">
                            <Grid Margin="10,10,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Almacenes Origen -->
                                <GroupBox Header="Origen" 
                                          Grid.Column="0" 
                                          Margin="0,0,10,0"
                               FontSize="12" 
                                          FontWeight="SemiBold">
                                    <Grid Margin="5,5,5,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding AlmacenesOrigenOrdenados}" 
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="All"
                                                  HeadersVisibility="Column"
                                                  MaxHeight="300"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="30"/>
                                                <DataGridTextColumn Header="Almacén" Binding="{Binding CodigoAlmacen}" Width="*"/>
                                                <DataGridTextColumn Header="Unidades" Binding="{Binding UnidadesMovidas, StringFormat=N2}" Width="Auto"/>
                                                <DataGridTextColumn Header="Traspasos" Binding="{Binding CantidadTraspasos}" Width="Auto"/>
                                                <DataGridTextColumn Header="%" Width="Auto">
                                                    <DataGridTextColumn.Binding>
                                                        <MultiBinding Converter="{StaticResource PorcentajeDistribucionConverter}">
                                                            <Binding Path="DataContext.DistribucionPorUnidades" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- Almacenes Destino -->
                                <GroupBox Header="Destino" 
                                          Grid.Column="1"
                               FontSize="12" 
                                          FontWeight="SemiBold">
                                    <Grid Margin="5,5,5,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding AlmacenesDestinoOrdenados}" 
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="All"
                                                  HeadersVisibility="Column"
                                                  MaxHeight="300"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="30"/>
                                                <DataGridTextColumn Header="Almacén" Binding="{Binding CodigoAlmacen}" Width="*"/>
                                                <DataGridTextColumn Header="Unidades" Binding="{Binding UnidadesMovidas, StringFormat=N2}" Width="Auto"/>
                                                <DataGridTextColumn Header="Traspasos" Binding="{Binding CantidadTraspasos}" Width="Auto"/>
                                                <DataGridTextColumn Header="%" Width="Auto">
                                                    <DataGridTextColumn.Binding>
                                                        <MultiBinding Converter="{StaticResource PorcentajeDistribucionConverter}">
                                                            <Binding Path="DataContext.DistribucionPorUnidades" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <!-- Top Ubicaciones -->
                        <GroupBox Header="Top 10 Ubicaciones" 
                                  Grid.Row="2" 
                                  Margin="0,0,0,20"
                                  FontSize="14"
                                  FontWeight="Bold">
                            <Grid Margin="10,10,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ubicaciones Origen -->
                                <GroupBox Header="Origen" 
                                          Grid.Column="0" 
                                          Margin="0,0,10,0"
                               FontSize="12" 
                                          FontWeight="SemiBold">
                                    <Grid Margin="5,5,5,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding UbicacionesOrigenOrdenadas}" 
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="All"
                                                  HeadersVisibility="Column"
                                                  MaxHeight="300"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="30"/>
                                                <DataGridTextColumn Header="Almacén" Binding="{Binding CodigoAlmacen}" Width="Auto"/>
                                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*"/>
                                                <DataGridTextColumn Header="Unidades" Binding="{Binding UnidadesMovidas, StringFormat=N2}" Width="Auto"/>
                                                <DataGridTextColumn Header="Traspasos" Binding="{Binding CantidadTraspasos}" Width="Auto"/>
                                                <DataGridTextColumn Header="%" Width="Auto">
                                                    <DataGridTextColumn.Binding>
                                                        <MultiBinding Converter="{StaticResource PorcentajeDistribucionConverter}">
                                                            <Binding Path="DataContext.DistribucionPorUnidades" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>

                                <!-- Ubicaciones Destino -->
                                <GroupBox Header="Destino" 
                                          Grid.Column="1"
                                          FontSize="12"
                                          FontWeight="SemiBold">
                                    <Grid Margin="5,5,5,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding UbicacionesDestinoOrdenadas}" 
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="All"
                                                  HeadersVisibility="Column"
                                                  MaxHeight="300"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="30"/>
                                                <DataGridTextColumn Header="Almacén" Binding="{Binding CodigoAlmacen}" Width="Auto"/>
                                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*"/>
                                                <DataGridTextColumn Header="Unidades" Binding="{Binding UnidadesMovidas, StringFormat=N2}" Width="Auto"/>
                                                <DataGridTextColumn Header="Traspasos" Binding="{Binding CantidadTraspasos}" Width="Auto"/>
                                                <DataGridTextColumn Header="%" Width="Auto">
                                                    <DataGridTextColumn.Binding>
                                                        <MultiBinding Converter="{StaticResource PorcentajeDistribucionConverter}">
                                                            <Binding Path="DataContext.DistribucionPorUnidades" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>

                        <!-- Flujos Principales -->
                        <GroupBox Header="Top 10 Flujos Principales (Origen → Destino)" 
                                  Grid.Row="3" 
                                  Margin="0,0,0,20"
                                  FontSize="14"
                                  FontWeight="Bold">
                            <Grid Margin="10,10,10,10">
                                <DataGrid ItemsSource="{Binding FlujosOrdenados}" 
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="All"
                                          HeadersVisibility="Column"
                                          MaxHeight="400"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Posicion}" Width="30"/>
                                        <DataGridTextColumn Header="Almacén Origen" Binding="{Binding AlmacenOrigen}" Width="Auto"/>
                                        <DataGridTextColumn Header="Ubicación Origen" Binding="{Binding UbicacionOrigen}" Width="Auto"/>
                                        <DataGridTextColumn Header="→" Width="30" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Almacén Destino" Binding="{Binding AlmacenDestino}" Width="Auto"/>
                                        <DataGridTextColumn Header="Ubicación Destino" Binding="{Binding UbicacionDestino}" Width="Auto"/>
                                        <DataGridTextColumn Header="Unidades" Binding="{Binding UnidadesMovidas, StringFormat=N2}" Width="Auto"/>
                                        <DataGridTextColumn Header="Traspasos" Binding="{Binding CantidadTraspasos}" Width="Auto"/>
                                        <DataGridTextColumn Header="%" Binding="{Binding PorcentajeDelTotal, StringFormat='{}{0:F1}%'}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>

                <!-- Artículos -->
                <Grid Visibility="{Binding MostrandoArticulos, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Encabezado -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource BrushPrincipal}"
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <TextBlock Text="📋 Análisis por Código de Familia" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Panel de Ordenación -->
                    <Border Grid.Row="1" 
                            Background="{StaticResource BrushPrincipal}"
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Ordenar por:" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"
                                       FontWeight="SemiBold"/>
                            
                            <ComboBox Grid.Column="1" 
                                      SelectedValue="{Binding CriterioOrdenacionArticulos}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Cantidad Traspasos" Tag="CantidadTraspasos"/>
                                <ComboBoxItem Content="Unidades Totales" Tag="UnidadesTotales"/>
                                <ComboBoxItem Content="Tiempo Promedio" Tag="TiempoPromedio"/>
                                <ComboBoxItem Content="Eficiencia" Tag="Eficiencia"/>
                                <ComboBoxItem Content="Almacenes Únicos" Tag="AlmacenesUnicos"/>
                                <ComboBoxItem Content="Código de Familia" Tag="CodigoFamilia"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <!-- Tabla de Artículos -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Articulos}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" 
                                                Binding="{Binding Posicion}" 
                                                Width="40"
                                                CanUserResize="False">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Código de Familia" 
                                                Binding="{Binding CodigoFamilia}" 
                                                Width="*"
                                                MinWidth="180">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Artículos Únicos" 
                                                Binding="{Binding CantidadArticulosUnicos, StringFormat=N0}" 
                                                Width="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Traspasos" 
                                                Binding="{Binding CantidadTraspasos, StringFormat=N0}" 
                                                Width="80">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unidades Totales" 
                                                Binding="{Binding UnidadesTotalesMovidas, StringFormat=N2}" 
                                                Width="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Promedio Unid/Trasp." 
                                                Binding="{Binding PromedioUnidadesPorTraspaso, StringFormat=N2}" 
                                                Width="130">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tiempo Prom. (min)" 
                                                Binding="{Binding TiempoPromedioMinutos, StringFormat=F2}" 
                                                Width="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tiempo Total (min)" 
                                                Binding="{Binding TiempoTotalMinutos, StringFormat=F2}" 
                                                Width="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Eficiencia (unid/min)" 
                                                Binding="{Binding EficienciaUnidadesPorMinuto, StringFormat=F2}" 
                                                Width="140">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Almacenes" 
                                                Binding="{Binding AlmacenesUnicos, StringFormat=N0}" 
                                                Width="80">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ubicaciones" 
                                                Binding="{Binding UbicacionesUnicas, StringFormat=N0}" 
                                                Width="90">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Operarios" 
                                                Binding="{Binding OperariosUnicos, StringFormat=N0}" 
                                                Width="80">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="% del Total" 
                                                Binding="{Binding PorcentajeDelTotalTraspasos, StringFormat='{}{0:F2}%'}" 
                                                Width="100">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="35"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>

                <!-- Eficiencia -->
                <DataGrid ItemsSource="{Binding Procesos}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Visibility="{Binding MostrandoEficiencia, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo Proceso" Binding="{Binding TipoProceso}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalProcesos}" Width="Auto"/>
                        <DataGridTextColumn Header="Completados" Binding="{Binding ProcesosCompletados}" Width="Auto"/>
                        <DataGridTextColumn Header="Pendientes" Binding="{Binding ProcesosPendientes}" Width="Auto"/>
                        <DataGridTextColumn Header="Tasa Finalización (%)" Binding="{Binding TasaFinalizacion, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Tiempo Promedio (min)" Binding="{Binding TiempoPromedioMinutos, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Líneas/Hora" Binding="{Binding LineasPorHora, StringFormat=F1}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tendencias -->
                <DataGrid ItemsSource="{Binding PuntosTendencia}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Visibility="{Binding MostrandoTendencias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="Auto"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Comparativas -->
                <DataGrid ItemsSource="{Binding ItemsComparativa}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Visibility="{Binding MostrandoComparativas, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Etiqueta" Binding="{Binding Etiqueta}" Width="*"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="Auto"/>
                        <DataGridTextColumn Header="Variación (%)" Binding="{Binding Variacion, StringFormat=F1}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Indicador de carga -->
                <Border Background="#80000000" 
                        Visibility="{Binding EstaCargando, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Cargando..." 
                                   FontSize="18" 
                                   Foreground="White" 
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>

