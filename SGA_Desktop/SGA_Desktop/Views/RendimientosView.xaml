<Page x:Class="SGA_Desktop.Views.RendimientosView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SGA_Desktop.ViewModels"
      xmlns:models="clr-namespace:SGA_Desktop.Models"
      Title="Análisis de Rendimientos"
      Background="{StaticResource BrushFondo}">
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Filtros -->
            <RowDefinition Height="Auto"/> <!-- Pestañas -->
            <RowDefinition Height="*"/> <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Panel de Filtros -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="{StaticResource BrushPrincipal}"
                BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="FILTROS:" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,15,0"
                           Foreground="{StaticResource BrushPrincipal}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Fecha Desde" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FechaDesde}" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Fecha Hasta" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FechaHasta}" Width="150"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Aplicar Filtros" 
                            Command="{Binding AplicarFiltrosCommand}"
                            Style="{StaticResource EstiloBotonPrincipal}"
                            Margin="0,0,10,0"
                            Padding="15,8"/>
                    <Button Content="Limpiar" 
                            Command="{Binding LimpiarFiltrosCommand}"
                            Style="{StaticResource EstiloBotonPrincipal}"
                            Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOTONES DE PESTAÑAS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="👤 Operarios"
                    Command="{Binding CambiarAOperariosCommand}"
                    Width="140"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoOperarios}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📦 Volumen Movido"
                    Command="{Binding CambiarAVolumenCommand}"
                    Width="160"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoVolumen}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📍 Distribución"
                    Command="{Binding CambiarADistribucionCommand}"
                    Width="140"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoDistribucion}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📋 Artículos"
                    Command="{Binding CambiarAArticulosCommand}"
                    Width="120"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoArticulos}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="⚡ Eficiencia"
                    Command="{Binding CambiarAEficienciaCommand}"
                    Width="120"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoEficiencia}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📈 Tendencias"
                    Command="{Binding CambiarATendenciasCommand}"
                    Width="130"
                    Height="35"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoTendencias}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📊 Comparativas"
                    Command="{Binding CambiarAComparativasCommand}"
                    Width="150"
                    Height="35">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushPrincipal}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoComparativas}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushPrincipal}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Contenido según Pestaña -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="8" 
                Padding="15"
                BorderBrush="{StaticResource BrushPrincipal}"
                BorderThickness="2">
            <Grid>
                <!-- Operarios - Lista Expandible -->
                <Grid Visibility="{Binding MostrandoOperarios, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filtros y ordenación -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource BrushPrincipal}"
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Buscar:" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"
                                       FontWeight="SemiBold"/>
                            
                            <TextBox Grid.Column="1" 
                                     Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,20,0"/>
                            
                            <TextBlock Grid.Column="2" 
                                       Text="Ordenar por:" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0"
                                       FontWeight="SemiBold"/>
                            
                            <ComboBox Grid.Column="3" 
                                      SelectedValue="{Binding CriterioOrdenacion}"
                                      SelectedValuePath="Tag"
                                      Height="30"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Total Operaciones" Tag="TotalOperaciones"/>
                                <ComboBoxItem Content="Traspasos Completados" Tag="TraspasosCompletados"/>
                                <ComboBoxItem Content="Tiempo Promedio" Tag="TiempoPromedio"/>
                                <ComboBoxItem Content="Traspasos/Día" Tag="TraspasosPorDia"/>
                                <ComboBoxItem Content="Ranking" Tag="Ranking"/>
                                <ComboBoxItem Content="Nombre" Tag="Nombre"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Operarios}" Margin="0,5,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="6" 
                                        Padding="0"
                                        Margin="0,0,0,8"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BrushIntermedio}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Badge de Ranking -->
                                                <Border Grid.Column="0" 
                                                        Background="#FFD700" 
                                                        CornerRadius="3" 
                                                        Padding="6,2" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#DAA520"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ranking}" Value="1">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🥇 TOP 1" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#2C2C2C"/>
                                                </Border>
                                                <Border Grid.Column="0" 
                                                        Background="#C0C0C0" 
                                                        CornerRadius="3" 
                                                        Padding="6,2" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#A0A0A0"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ranking}" Value="2">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🥈 TOP 2" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#2C2C2C"/>
                                                </Border>
                                                <Border Grid.Column="0" 
                                                        Background="#CD7F32" 
                                                        CornerRadius="3" 
                                                        Padding="6,2" 
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="#A0522D"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ranking}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="🥉 TOP 3" 
                                                               FontSize="10" 
                                                               FontWeight="Bold" 
                                                               Foreground="#2C2C2C"/>
                                                </Border>
                                                
                                                <!-- Nombre -->
                                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NombreOperario}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="{StaticResource BrushPrincipal}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Ranking: #" 
                                                                   FontSize="10" 
                                                                   Foreground="Gray"/>
                                                        <TextBlock Text="{Binding Ranking}" 
                                                                   FontSize="10" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="Gray"/>
                                                        <TextBlock Text=" | " 
                                                                   FontSize="10" 
                                                                   Foreground="Gray" 
                                                                   Margin="3,0"/>
                                                        <TextBlock FontSize="10" 
                                                                   Foreground="Gray">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F1}% del total">
                                                                    <Binding Path="PorcentajeDelTotal"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Total Operaciones -->
                                                <StackPanel Grid.Column="2" 
                                                            Orientation="Vertical" 
                                                            Margin="20,0,15,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Total" 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding TotalOperaciones}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black"/>
                                                </StackPanel>
                                                
                                                <!-- Traspasos -->
                                                <StackPanel Grid.Column="3" 
                                                            Orientation="Vertical" 
                                                            Margin="0,0,15,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Traspasos" 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding TraspasosCompletados}" 
                                                               FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black"/>
                                                    <TextBlock FontSize="9" 
                                                               Foreground="Gray">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F1}/día">
                                                                <Binding Path="TraspasosPorDia"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- Tiempo Promedio -->
                                                <StackPanel Grid.Column="4" 
                                                            Orientation="Vertical" 
                                                            Margin="0,0,15,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Tiempo Prom." 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock FontSize="16" 
                                                               FontWeight="Bold" 
                                                               Foreground="Black">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F1} min">
                                                                <Binding Path="TiempoPromedioTraspasosMinutos"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock FontSize="9" 
                                                               Foreground="Gray"
                                                               Visibility="{Binding VariacionPorcentual, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:+#0.0;-#0.0;0}% vs promedio">
                                                                <Binding Path="VariacionPorcentual"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <!-- Indicador de actividad -->
                                                <StackPanel Grid.Column="5" 
                                                            Orientation="Vertical" 
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Días Activos" 
                                                               FontSize="10" 
                                                               Foreground="Gray"/>
                                                    <TextBlock Text="{Binding DiasActivos}" 
                                                               FontSize="14" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="Black"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        
                                        <!-- Contenido expandido -->
                                        <Grid Margin="15,10,15,15">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Métricas de Traspasos -->
                                            <GroupBox Header="Traspasos" 
                                                      Grid.Row="0" 
                                                      Margin="0,0,0,10"
                                                      FontSize="12"
                                                      FontWeight="Bold">
                                                <Grid Margin="10,10,10,5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Primera fila: Tipos de traspasos -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Traspasos Palet" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding TraspasosPalet}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Traspasos Artículo" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding TraspasosArticulo}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Tasa Finalización" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1}%">
                                                                        <Binding Path="TasaFinalizacion"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                    
                                                    <!-- Segunda fila: Tiempos -->
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Tiempo Promedio" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoPromedioTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Tiempo Mediano" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoMedianoTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Más Rápido" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#4CAF50">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoMinimoTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="Más Lento" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#F44336">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoMaximoTraspasosMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </GroupBox>
                                            
                                            <!-- Distribución -->
                                            <GroupBox Header="Distribución" 
                                                      Grid.Row="1" 
                                                      Margin="0,0,0,10"
                                                      FontSize="12"
                                                      FontWeight="Bold">
                                                <Grid Margin="10,10,10,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Almacenes Diferentes" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding AlmacenesDiferentes}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Artículos Diferentes" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding ArticulosDiferentes}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Última Actividad" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                        <TextBlock FontSize="14" FontWeight="SemiBold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:dd/MM/yyyy HH:mm}">
                                                                    <Binding Path="UltimaActividad"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </GroupBox>
                                            
                                            <!-- Métricas de Inventarios y Conteos -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Inventarios -->
                                                <GroupBox Header="Inventarios" 
                                                          Grid.Column="0" 
                                                          Margin="0,0,5,0"
                                                          FontSize="12"
                                                          FontWeight="Bold">
                                                    <Grid Margin="10,10,10,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                            <TextBlock Text="Líneas Contadas" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding LineasInventarioContadas}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="1">
                                                            <TextBlock Text="Líneas/Hora" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1}">
                                                                        <Binding Path="LineasPorHora"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </GroupBox>
                                                
                                                <!-- Conteos -->
                                                <GroupBox Header="Conteos" 
                                                          Grid.Column="1" 
                                                          Margin="5,0,0,0"
                                                          FontSize="12"
                                                          FontWeight="Bold">
                                                    <Grid Margin="10,10,10,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                            <TextBlock Text="Lecturas" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding LecturasConteo}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                            <TextBlock Text="Completados" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding ConteosCompletados}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Row="2">
                                                            <TextBlock Text="Tiempo Promedio" FontSize="11" Foreground="Gray" Margin="0,0,0,3"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1} min">
                                                                        <Binding Path="TiempoPromedioConteoMinutos"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </GroupBox>
                                            </Grid>
                                        </Grid>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Volumen Movido -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Visibility="{Binding MostrandoVolumen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📦 Volumen Movido" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrincipal}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Esta sección mostrará:" 
                               FontSize="14" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="• Total de unidades movidas" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Total de kilos movidos" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Valor económico movido" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Palets únicos movidos" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Text="(Próximamente)" 
                               FontSize="12" 
                               FontStyle="Italic"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Distribución -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Visibility="{Binding MostrandoDistribucion, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📍 Distribución por Almacén/Ubicación" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrincipal}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Esta sección mostrará:" 
                               FontSize="14" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="• Top almacenes origen/destino" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Top ubicaciones más activas" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Flujos principales (origen → destino)" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Text="(Próximamente)" 
                               FontSize="12" 
                               FontStyle="Italic"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Artículos -->
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Visibility="{Binding MostrandoArticulos, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📋 Artículos Más Movidos" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrincipal}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Esta sección mostrará:" 
                               FontSize="14" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="• Top N artículos por cantidad" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Top N artículos por frecuencia" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="• Rotación de artículos" 
                               FontSize="12" 
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Text="(Próximamente)" 
                               FontSize="12" 
                               FontStyle="Italic"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Eficiencia -->
                <DataGrid ItemsSource="{Binding Procesos}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Visibility="{Binding MostrandoEficiencia, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo Proceso" Binding="{Binding TipoProceso}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalProcesos}" Width="Auto"/>
                        <DataGridTextColumn Header="Completados" Binding="{Binding ProcesosCompletados}" Width="Auto"/>
                        <DataGridTextColumn Header="Pendientes" Binding="{Binding ProcesosPendientes}" Width="Auto"/>
                        <DataGridTextColumn Header="Tasa Finalización (%)" Binding="{Binding TasaFinalizacion, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Tiempo Promedio (min)" Binding="{Binding TiempoPromedioMinutos, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Líneas/Hora" Binding="{Binding LineasPorHora, StringFormat=F1}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tendencias -->
                <DataGrid ItemsSource="{Binding PuntosTendencia}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Visibility="{Binding MostrandoTendencias, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="Auto"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Comparativas -->
                <DataGrid ItemsSource="{Binding ItemsComparativa}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="Column"
                          Visibility="{Binding MostrandoComparativas, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Etiqueta" Binding="{Binding Etiqueta}" Width="*"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=F1}" Width="Auto"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="Auto"/>
                        <DataGridTextColumn Header="Variación (%)" Binding="{Binding Variacion, StringFormat=F1}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Indicador de carga -->
                <Border Background="#80000000" 
                        Visibility="{Binding EstaCargando, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Cargando..." 
                                   FontSize="18" 
                                   Foreground="White" 
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>

