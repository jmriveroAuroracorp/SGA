<Page x:Class="SGA_Desktop.Views.GestionUbicacionesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Gestión de Ubicaciones" Cursor="">

    <Page.Resources>
        <!-- Conversores -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <helpers:ArrayConverter x:Key="ArrayConverter"/>
    </Page.Resources>

    <Grid Margin="10" Background="{StaticResource BrushFondo}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filtro -->
            <RowDefinition Height="*"/>
            <!-- ⬅ Barra acciones -->
            <RowDefinition Height="Auto"/>
            <!-- Listado -->
        </Grid.RowDefinitions>

        <!-- 2) Filtros y Botones -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Filtros a la izquierda -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                    <TextBlock Text="Almacén" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox Width="250"
                        Height="40"
                        Style="{StaticResource EstiloComboBox}"
                        ItemsSource="{Binding AlmacenesCombo}"
                        DisplayMemberPath="DescripcionCombo"
                        SelectedItem="{Binding SelectedAlmacenCombo, Mode=TwoWay}"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        VerticalAlignment="Top">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </StackPanel>
                
                <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                    <TextBlock Text="Buscar" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Width="250"
                             Height="40"
                             FontFamily="{StaticResource FuentePrincipal}"
                             FontSize="14"
                             Padding="8,4"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushInputBorde}"
                             Background="White"
                             Text="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Top"
                             VerticalContentAlignment="Center"
                             ToolTip="Buscar por ubicación, descripción, tipo, pasillo, estantería, altura o posición"/>
                </StackPanel>
                
                <CheckBox Content="Mostrar obsoletas" 
                          IsChecked="{Binding MostrarObsoletas}"
                          Margin="0,28,0,0"
                          VerticalAlignment="Top"
                          VerticalContentAlignment="Center"/>
            </StackPanel>
            
            <!-- Botones a la derecha -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="0,28,0,0">
                <!-- Botón Editar (solo visible cuando hay más de una seleccionada) -->
                <Button Content="Editar"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding EditarSeleccionadasCommand}"
                        Padding="8,4"
                        Width="120"
                        Margin="0,0,10,0"
                        ToolTip="Editar ubicaciones seleccionadas"
                        Visibility="{Binding HayMasDeUnaSeleccionada, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Nueva ubicación"
                        Margin="0,0,10,0"
                        Padding="8,4"
                        Width="150"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding CreateUbicacionCommand}"
                        CommandParameter="{Binding SelectedAlmacenCombo}"
                        ToolTip="Crear una ubicación en este almacén"/>
                <Button Content="Multiples ubicaciones"
                        Padding="8,4"
                        Width="150"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding OpenMasivoCommand}"
                        CommandParameter="{Binding SelectedAlmacenCombo}"
                        ToolTip="Generar ubicaciones en bloque"/>
                <Button Content="Refrescar"
                        Padding="8,4"
                        Width="100"
                        Margin="10,0,0,0"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding RefrescarCommand}"
                        ToolTip="Actualizar la lista de ubicaciones"/>
            </StackPanel>
        </Grid>

        
        <!-- 3) ItemsControl con agrupación por pasillo -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding UbicacionesAgrupadas}">
                    <ItemsControl.ItemTemplate>
                <DataTemplate>
                            <!-- Expander para cada grupo de pasillo -->
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Margin="0,0,0,12">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HeaderPasillo}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource BrushPrincipal}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TotalUbicaciones, StringFormat='({0} ubicaciones)'}"
                                                           FontSize="12"
                                                           Foreground="#666"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            <Menu Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"
                                                  DataContext="{Binding}">
                                                <MenuItem Header="Seleccionar por...">
                                                    <MenuItem Header="Todas"
                                                              Command="{Binding DataContext.SeleccionarTodoElPasilloCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                              CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                                    <MenuItem Header="Estantería"
                                                              ItemsSource="{Binding EstanteriasDisponibles}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EsEspecial}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding}"/>
                                                                <Setter Property="Command" Value="{Binding DataContext.SeleccionarPorEstanteriaEnGrupoCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                                                <Setter Property="CommandParameter">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource ArrayConverter}">
                                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Menu}"/>
                                                                            <Binding/>
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>
                                                    <MenuItem Header="Altura"
                                                              ItemsSource="{Binding AlturasDisponibles}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EsEspecial}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding}"/>
                                                                <Setter Property="Command" Value="{Binding DataContext.SeleccionarPorAlturaEnGrupoCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                                                <Setter Property="CommandParameter">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource ArrayConverter}">
                                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Menu}"/>
                                                                            <Binding/>
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>
                                                </MenuItem>
                                            </Menu>
                                            </Grid>
                                        </Expander.Header>
                                
                                <!-- ItemsControl para las ubicaciones dentro del grupo -->
                                <ItemsControl ItemsSource="{Binding Ubicaciones}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EstiloTarjeta}" 
                                                    Width="380" 
                                                    Height="Auto" 
                                                    MinHeight="200"
                                                    Margin="6"
                                                    Cursor="Hand">
                                                <Grid>
                                        <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                                    <!-- Header con Código y Badges -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Código Ubicación -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Ubicación: " 
                                                                       FontWeight="Bold" 
                                                                       Foreground="{StaticResource BrushPrincipal}"
                                                                       FontSize="14"
                                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Ubicacion}"
                                                                       FontFamily="Consolas"
                                                       FontWeight="Bold"
                                                                       Foreground="#2C3E50"
                                                                       FontSize="14"
                                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                                        <!-- Badges -->
                                                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <!-- Badges horizontales: OBSOLETA y Activa -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="#D32F2F"
                                                    BorderBrush="#B71C1C"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="6,3"
                                                                    Margin="0,0,5,0"
                                                    Visibility="{Binding Obsoleta, Converter={StaticResource IntToVisibilityConverter}}">
                                                <TextBlock Text="OBSOLETA"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                            <Border Background="#4CAF50"
                                                                    BorderThickness="1"
                                                                    BorderBrush="#4CAF50"
                                                                    CornerRadius="3"
                                                                    Padding="6,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Habilitada}" Value="True"/>
                                                                    <Condition Binding="{Binding Obsoleta}" Value="0"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                                <TextBlock Text="Activa" 
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Badge de Tipología -->
                                            <Border Background="#2196F3"
                                                    BorderThickness="1"
                                                    BorderBrush="#1976D2"
                                                    CornerRadius="3"
                                                    Padding="6,3"
                                                    Visibility="{Binding TipoUbicacionDescripcion, Converter={StaticResource StringToVisibilityConverter}}">
                                                <TextBlock Text="{Binding TipoUbicacionDescripcion}" 
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                                    </Grid>
                                        
                                                    <!-- Contenido principal -->
                                                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                        <!-- Descripción -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Descripción: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DescripcionUbicacion}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12"
                                                                       Foreground="#34495E"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>

                                                        <!-- Ubicación física -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Ubicación: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="P:" FontWeight="SemiBold" FontSize="12" Foreground="#34495E"/>
                                                                <TextBlock Text="{Binding Pasillo}" FontSize="12" Foreground="#34495E" Margin="0,0,8,0"/>
                                                                <TextBlock Text="E:" FontWeight="SemiBold" FontSize="12" Foreground="#34495E"/>
                                                                <TextBlock Text="{Binding Estanteria}" FontSize="12" Foreground="#34495E" Margin="0,0,8,0"/>
                                                                <TextBlock Text="A:" FontWeight="SemiBold" FontSize="12" Foreground="#34495E"/>
                                                                <TextBlock Text="{Binding Altura}" FontSize="12" Foreground="#34495E" Margin="0,0,8,0"/>
                                                                <TextBlock Text="Pos:" FontWeight="SemiBold" FontSize="12" Foreground="#34495E"/>
                                                                <TextBlock Text="{Binding Posicion}" FontSize="12" Foreground="#34495E"/>
                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Temperatura -->
                                                        <Grid Margin="0,0,0,8"
                                                              Visibility="{Binding TemperaturaMin, Converter={StaticResource IntToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Temperatura: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding TemperaturaMin, StringFormat={}{0}°C}" 
                                                                           FontSize="12" 
                                                                           Foreground="#34495E"/>
                                                                <TextBlock Text=" - " 
                                                                           FontSize="12" 
                                                                           Foreground="#34495E"
                                                                           Visibility="{Binding TemperaturaMax, Converter={StaticResource IntToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding TemperaturaMax, StringFormat={}{0}°C}" 
                                                                           FontSize="12" 
                                                                           Foreground="#34495E"
                                                                           Visibility="{Binding TemperaturaMax, Converter={StaticResource IntToVisibilityConverter}}"/>
                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Tipo Palet -->
                                                        <Grid Margin="0,0,0,8"
                                                              Visibility="{Binding TipoPaletPermitido, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Tipo Palet: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TipoPaletPermitido}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12"
                                                                       Foreground="#34495E"/>
                                    </Grid>

                                                        <!-- Expander para alérgenos (compacto) -->
                                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Margin="0,8,0,0">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="Expanded">
                                                                    <i:InvokeCommandAction
                                                                        Command="{Binding DataContext.LoadAlergenosCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                        CommandParameter="{Binding}" />
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                            
                                                            <Expander.Header>
                                                                <TextBlock Text="Alérgenos" 
                                                                           FontWeight="SemiBold" 
                                                                           FontSize="11"
                                                                           Foreground="#7F8C8D"/>
                                </Expander.Header>

                            <Expander.Content>
                                                                <Border BorderBrush="#E1E5E9"
                                                                        BorderThickness="0,1,0,0"
                                                                        Margin="0,8,0,0"
                                                                        Padding="8,8,0,0">
                                                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                            <TextBlock Text="Presentes" 
                                                                                       FontWeight="Bold" 
                                                                                       FontSize="10"
                                                                                       Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding AlergenosPresentesList}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel IsItemsHost="True"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource BrushSecundario1}"
                                                                                                CornerRadius="3"
                                                Padding="4,2"
                                                Margin="2">
                                                                                            <TextBlock Text="{Binding Descripcion}" FontSize="10"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                                                            <TextBlock Text="Ninguno"
                                                                                       FontStyle="Italic"
                                                                                       Foreground="Gray"
                                                                                       FontSize="10"
                                                                                       Margin="0,4,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding AlergenosPresentesList.Count}" Value="0">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="Permitidos" 
                                                                                       FontWeight="Bold" 
                                                                                       FontSize="10"
                                                                                       Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding AlergenosPermitidosList}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel IsItemsHost="True"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BrushSecundario2}"
                                                                                                CornerRadius="3"
                                                    Padding="4,2"
                                                    Margin="2">
                                                                                            <TextBlock Text="{Binding Descripcion}" FontSize="10"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                                            <TextBlock Text="Sin limitaciones"
                                       FontStyle="Italic"
                                       Foreground="Gray"
                                                                                       FontSize="10"
                                                                                       Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlergenosPermitidosList.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                                                        </StackPanel>
                                        </Grid>
                                                                </Border>
                            </Expander.Content>
                            </Expander>
                                                    </StackPanel>

                                                    <!-- Botones de acción -->
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Editar"
                                                                Command="{Binding DataContext.EditarUbicacionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource EstiloBoton}"
                                                                Width="80"
                                                                Height="30"
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Margin="0,0,4,0"/>
                                                        <CheckBox IsChecked="{Binding IsMarcada, Mode=TwoWay}"
                  VerticalAlignment="Center"
                                                                  Margin="4,0,0,0"
                                                                  ToolTip="Seleccionar ubicación"/>
                                                    </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Indicador de carga -->
            <Border Background="#E0E0E0" 
                    Opacity="0.8" 
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Cargando ubicaciones..." 
                               FontSize="14" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" 
                                  Width="100" 
                                  Height="20"/>
                </StackPanel>
            </Border>
            
            <!-- Mensaje cuando no hay ubicaciones -->
            <TextBlock Text="No hay ubicaciones disponibles"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UbicacionesAgrupadas.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        
        <!-- Barra inferior: Resumen y acciones simplificada -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Resumen a la izquierda -->
            <TextBlock Grid.Column="0" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center">
                    <Run Text="{Binding SeleccionadasCount, Mode=OneWay}"/>
                    <Run Text="de"/>
                    <Run Text="{Binding TotalUbicaciones, Mode=OneWay}"/>
                    <Run Text="seleccionadas"/>
                </TextBlock>
            
            <!-- Acciones a la derecha simplificadas -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                
                <!-- Botones de acción -->
                <Button Content="Seleccionar todo"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding SeleccionarTodoCommand}"
                        Height="32" 
                        Padding="8,0"
                        Margin="0,0,6,0"/>
                <Button Content="Limpiar selección"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding LimpiarSeleccionCommand}"
                        Height="32" 
                        Padding="8,0"
                        Margin="0,0,6,0"
                        IsEnabled="{Binding HaySeleccion}"/>
                <Button Content="Imprimir"
                        Style="{StaticResource EstiloBotonPrincipal}"
                        Command="{Binding ImprimirSeleccionadasCommand}"
                        Height="32" 
                        Padding="8,0"
                        IsEnabled="{Binding HaySeleccion}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
