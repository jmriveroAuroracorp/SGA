<Page x:Class="SGA_Desktop.Views.HistorialAjustesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Helpers="clr-namespace:SGA_Desktop.Helpers"
      xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
      xmlns:converters="clr-namespace:SGA_Desktop.Converters"
      xmlns:models="clr-namespace:SGA_Desktop.Models"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      Title="Historial de Ajustes"
      Background="{StaticResource BrushFondo}">
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SGA_Desktop;component/Resources/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
            <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
            
            <!-- Converters para ajustes -->
            <converters:EstadoToColorConverter x:Key="EstadoToColorConverter"/>
            <converters:EstadoToTextConverter x:Key="EstadoToTextConverter"/>
            <helpers:AjusteFinalColorConverter x:Key="AjusteFinalColorConverter"/>
            <helpers:AjusteFinalTextConverter x:Key="AjusteFinalTextConverter"/>
            <converters:OrigenToColorConverter x:Key="OrigenToColorConverter"/>
            
            <!-- DataTemplate para AjusteDto -->
            <DataTemplate DataType="{x:Type models:AjusteDto}" x:Key="AjusteDtoTemplate">
                <Border Background="White"
                        CornerRadius="6" 
                        Padding="12" 
                        BorderThickness="1" 
                        BorderBrush="{StaticResource BrushIntermedio}"
                        Cursor="Hand">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Badge de origen -->
                            <RowDefinition Height="Auto"/> <!-- Primera fila: Información principal -->
                            <RowDefinition Height="Auto"/> <!-- Segunda fila: Información secundaria -->
                        </Grid.RowDefinitions>
                        
                        <!-- Badge de origen -->
                        <Border Grid.Row="0" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top"
                                Background="{Binding Origen, Converter={StaticResource OrigenToColorConverter}}"
                                CornerRadius="10" 
                                Padding="6,2,6,2" 
                                Margin="0,0,0,8">
                            <TextBlock Text="{Binding OrigenTexto}" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="White"/>
                        </Border>
                        
                        <!-- Primera fila: Fecha, Artículo, Descripción, Lote, Caducidad, Estado, Diferencia -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Fecha -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FECHA" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" 
                                           FontSize="13" FontWeight="Bold" 
                                           Foreground="{StaticResource BrushPrincipal}"/>
                            </StackPanel>
                            
                            <!-- Artículo -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="ARTÍCULO" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding CodigoArticulo}" FontSize="13" FontWeight="Bold" 
                                           Foreground="{StaticResource BrushPrincipal}"/>
                            </StackPanel>
                            
                            <!-- Descripción -->
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="DESCRIPCIÓN" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding DescripcionArticulo}" FontSize="12" 
                                           Foreground="Black" TextWrapping="Wrap" 
                                           FontWeight="Medium" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <!-- Lote -->
                            <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                <TextBlock Text="LOTE" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Partida}" FontSize="13" FontWeight="Bold" 
                                           Foreground="{StaticResource BrushPrincipal}"/>
                            </StackPanel>

                            <!-- Caducidad -->
                            <StackPanel Grid.Column="4" Margin="6,0,0,0">
                                <TextBlock Text="CADUCIDAD" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding FechaCaducidad, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                           FontSize="13" FontWeight="Bold" 
                                           Foreground="{StaticResource BrushPrincipal}"/>
                            </StackPanel>
                            
                            <!-- Estado -->
                            <StackPanel Grid.Column="5" Margin="6,0,0,0">
                                <TextBlock Text="ESTADO" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" 
                                        Background="{Binding Estado, Converter={StaticResource EstadoToColorConverter}}">
                                    <TextBlock FontSize="9" FontWeight="Bold" 
                                               HorizontalAlignment="Center" Foreground="White"
                                               Text="{Binding Estado, Converter={StaticResource EstadoToTextConverter}}"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Diferencia -->
                            <StackPanel Grid.Column="6" Margin="6,0,0,0">
                                <TextBlock Text="DIFERENCIA" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="13" 
                                           FontWeight="Bold" 
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Diferencia, Converter={StaticResource AjusteFinalColorConverter}}"
                                           Text="{Binding Diferencia, Converter={StaticResource AjusteFinalTextConverter}}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Segunda fila: Almacén, Ubicación, Palet, Usuario, Origen -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        
                            <!-- Almacén -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="ALMACÉN" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding CodigoAlmacen}" FontSize="12" 
                                           FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}"/>
                            </StackPanel>
                            
                            <!-- Ubicación -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="UBICACIÓN" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding CodigoUbicacion}" FontSize="12" 
                                           FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}"/>
                            </StackPanel>
                            
                            <!-- Palet -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="PALET" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="11" FontWeight="Bold" 
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Sin paletizar"/>
                                            <Setter Property="Foreground" Value="#6C757D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CodigoPalet}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Sin paletizar"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CodigoPalet}" Value="">
                                                    <Setter Property="Text" Value="Sin paletizar"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text>
                                        <Binding Path="CodigoPalet" TargetNullValue="Sin paletizar"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- Usuario -->
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="USUARIO" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding UsuarioNombre}" FontSize="11" 
                                           Foreground="Black" FontWeight="Medium" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            
                            <!-- Origen (Inventario/Conteo) -->
                            <StackPanel Grid.Column="4" Margin="0,0,0,0">
                                <TextBlock Text="ORIGEN" FontSize="11" FontWeight="Bold" 
                                           Foreground="Gray" Margin="0,0,0,3"/>
                                <TextBlock FontSize="11" Foreground="Black" FontWeight="Medium" 
                                           TextWrapping="Wrap" Margin="0,0,0,2">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="OrigenTexto"/>
                                            <Binding Path="CodigoConteo" TargetNullValue=""/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding CodigoInventario}" FontSize="10" 
                                           Foreground="#6C757D" 
                                           Margin="0,0,0,0"
                                           Visibility="{Binding EsDeInventario, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock FontSize="10" 
                                           Foreground="#6C757D" 
                                           Margin="0,2,0,0"
                                           Visibility="{Binding EsDeConteo, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Creado por: {0}">
                                            <Binding Path="CreadorConteoDisplay"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Botones de acción -->
            <RowDefinition Height="*"/> <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Botones de acción -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Indicador de filtros activos -->
            <Border Grid.Column="0" 
                    Background="#E8F4FD" 
                    BorderBrush="#3498DB" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="10,6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍 Filtros activos: " 
                               FontWeight="SemiBold" 
                               FontSize="11"
                               Foreground="#2980B9"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ResumenFiltrosActivos}" 
                               FontSize="11"
                               Foreground="#34495E"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Botones de acción -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔍 Filtros" 
                        Command="{Binding AbrirFiltrosCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}" 
                        Width="120" Height="36" Margin="0,0,8,0"/>
                <Button Content="🔄 Recargar" 
                        Command="{Binding AplicarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonPrincipal}" 
                        Width="120" Height="36" Margin="0,0,8,0"/>
                <Button Content="🧹 Limpiar" 
                        Command="{Binding LimpiarFiltrosCommand}"
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Width="100" Height="36"/>
            </StackPanel>
        </Grid>

        <!-- Contenido -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E1E5E9" 
                BorderThickness="1" 
                CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Indicador de carga -->
                    <RowDefinition Height="*"/> <!-- Lista de ajustes -->
                </Grid.RowDefinitions>

                <!-- Indicador de carga -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Cargando..." 
                               Foreground="{StaticResource BrushPrincipal}" 
                               FontWeight="Bold" 
                               Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Historial de ajustes -->
                <GroupBox Header="Historial de Ajustes" Grid.Row="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Contador de resultados -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,20,10">
                            <TextBlock Text="{Binding Ajustes.Count, StringFormat='{}{0} ajustes encontrados'}" 
                                       Foreground="{StaticResource BrushPrincipal}" 
                                       FontWeight="Bold" 
                                       FontSize="12"/>
                        </StackPanel>
                        
                        <!-- Lista de ajustes -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding Ajustes}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="15,0,15,15"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="IsSelected" Value="False"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu Style="{StaticResource EstiloContextMenu}">
                                                <MenuItem Header="Copiar código artículo"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarCodigoCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding CodigoArticulo, TargetNullValue=''}" />
                                                <MenuItem Header="Copiar descripción"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarDescripcionCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding DescripcionArticulo, TargetNullValue=''}"/>
                                                <MenuItem Header="Copiar lote"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarLoteCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding Partida, TargetNullValue=''}"/>
                                                <MenuItem Header="Copiar fecha caducidad"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarFechaCaducidadCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding FechaCaducidad}"/>
                                                <Separator/>
                                                <MenuItem Header="Copiar almacén"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarAlmacenCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding CodigoAlmacen, TargetNullValue=''}"/>
                                                <MenuItem Header="Copiar ubicación"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarUbicacionCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding CodigoUbicacion, TargetNullValue=''}"/>
                                                <MenuItem Header="Copiar código palet"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarCodigoPaletCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding CodigoPalet, TargetNullValue=''}"/>
                                                <MenuItem Header="Copiar diferencia"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarDiferenciaCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding Diferencia}"/>
                                                <MenuItem Header="Copiar usuario"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarUsuarioCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding UsuarioNombre, TargetNullValue=''}"/>
                                                <Separator/>
                                                <MenuItem Header="Copiar estado"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarEstadoCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding Estado, TargetNullValue=''}"/>
                                                <MenuItem Header="Copiar fecha"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarFechaCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding Fecha}"/>
                                                <MenuItem Header="Copiar código inventario"
                                                          Style="{StaticResource EstiloMenuItem}"
                                                          Command="{Binding Data.CopiarCodigoInventarioCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding CodigoInventario, TargetNullValue=''}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <StaticResource ResourceKey="AjusteDtoTemplate"/>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</Page>

