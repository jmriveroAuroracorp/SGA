<Page x:Class="SGA_Desktop.Views.TraspasosStockView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
      mc:Ignorable="d"
      Title="Traspasos de Stock">
    <Grid Background="{StaticResource BrushFondo}" Margin="20">
        <Grid.Resources>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <helpers:NullToBoolConverter x:Key="NullToBoolConverter" />
            <helpers:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
            <helpers:NegativeValueColorConverter x:Key="NegativeValueColorConverter"/>
            <helpers:TipoBloqueoDisplayConverter x:Key="TipoBloqueoDisplayConverter"/>
            <DataTemplate x:Key="ArticuloExpanderHeaderTemplate">
                <StackPanel Orientation="Horizontal" Margin="8,2">
                    <TextBlock Text="{Binding CodigoArticulo}" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrincipal}" 
                               FontSize="16"/>
                    <TextBlock Text=" - " FontSize="16"/>
                    <TextBlock Text="{Binding DescripcionArticulo}" 
                               Foreground="#444" 
                               FontSize="16"/>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Buscador -->
            <RowDefinition Height="*"/> <!-- Tabla de stock - ocupa todo el espacio disponible -->
            <RowDefinition Height="Auto"/> <!-- Botón traspasar -->
        </Grid.RowDefinitions>

        <!-- Buscador de artículo -->
        <Grid Margin="0,0,0,16" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Lado izquierdo: Buscador y Filtros -->
            <StackPanel Grid.Column="0">
                <!-- Fila 1: Buscador de artículo y Botones -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Buscador -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Buscar artículo:" 
                                   Style="{StaticResource LabelStyle}" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrincipal}"/>
                        <TextBox Width="200" 
                                 Height="36"
                                 Margin="8,0,0,0" 
                                 Style="{StaticResource EstiloCajaTexto}"
                             Text="{Binding ArticuloBuscado, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding BuscarStockCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                        <Button Content="🔍" 
                                Width="40" 
                                Height="36" 
                                Margin="8,0,0,0" 
                                Style="{StaticResource EstiloBotonPrincipal}"
                            Command="{Binding BuscarStockCommand}"/>
                </StackPanel>
                
                    <!-- Botones de acción alineados con el buscador -->
                    <StackPanel Grid.Column="2" 
                               Orientation="Horizontal" 
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Content="Traspaso múltiple"
                                Width="140" 
                                Height="36" 
                                Margin="0,0,8,0"
                                Style="{StaticResource EstiloBotonPrincipal}"
                                Command="{Binding AbrirDialogoRegularizacionMultipleCommand}"/>
                        <Button Content="Refrescar"
                                Width="120" 
                                Height="36"
                                Command="{Binding RefrescarCommand}"
                                Style="{StaticResource EstiloBotonPrincipal}"
                                ToolTip="Actualizar la lista de stock"/>
                    </StackPanel>
                </Grid>
                
                <!-- Fila 2: Filtros -->
                <StackPanel Orientation="Horizontal" 
                            Visibility="{Binding MostrarComboAlmacenes, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <!-- Filtro de Almacén -->
                    <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                        <TextBlock Text="Filtrar por almacén" 
                                   FontWeight="Bold" 
                                   FontSize="13"
                                   Foreground="{StaticResource BrushPrincipal}"
                                   Margin="0,0,0,4"/>
                        <ComboBox Width="220" 
                                  Height="36"
                                  Style="{StaticResource EstiloComboBox}"
                                  ItemsSource="{Binding AlmacenesFiltro}"
                                  DisplayMemberPath="DescripcionCombo"
                                  SelectedItem="{Binding AlmacenFiltroSeleccionado, Mode=TwoWay}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"/>
                    </StackPanel>
                    
                    <!-- Filtro de Partida -->
                    <StackPanel Orientation="Vertical" 
                                Margin="0,0,20,0"
                                Visibility="{Binding MostrarFiltroPartida, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Filtrar por partida" 
                                   FontWeight="Bold" 
                                   FontSize="13"
                                   Foreground="{StaticResource BrushPrincipal}"
                                   Margin="0,0,0,4"/>
                        <ComboBox Width="180" 
                                  Height="36"
                                  Style="{StaticResource EstiloComboBox}"
                                  ItemsSource="{Binding PartidasDisponibles}"
                                  SelectedItem="{Binding PartidaSeleccionada, Mode=TwoWay}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  ToolTip="Selecciona o escribe para filtrar por partida"/>
                    </StackPanel>
                    
                    <!-- Filtro de Palets -->
                    <StackPanel Orientation="Vertical" 
                                Margin="0,0,0,0"
                                Visibility="{Binding MostrarFiltroPalets, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Filtrar por palet" 
                                   FontWeight="Bold" 
                                   FontSize="13"
                                   Foreground="{StaticResource BrushPrincipal}"
                                   Margin="0,0,0,4"/>
                        <ComboBox Width="180" 
                                  Height="36"
                                  Style="{StaticResource EstiloComboBox}"
                                  ItemsSource="{Binding PaletsDisponibles}"
                                  SelectedItem="{Binding PaletSeleccionado, Mode=TwoWay}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  ToolTip="Selecciona o escribe para filtrar por palet"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            
            <!-- Espaciador para mantener el layout -->
            <StackPanel Grid.Column="1" />
        </Grid>

        <!-- Stock disponible: agrupado o clásico -->
        <GroupBox Header="Stock disponible" Margin="0,0,0,16" Grid.Row="1" Grid.RowSpan="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl ItemsSource="{Binding ArticulosConUbicaciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander HeaderTemplate="{StaticResource ArticuloExpanderHeaderTemplate}" Header="{Binding .}" Margin="0,0,0,8"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <ItemsControl ItemsSource="{Binding Ubicaciones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SeleccionarStockCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="CardBorder"
                                                                                BorderBrush="{StaticResource BrushPrincipal}"
                                                                                BorderThickness="2"
                                                                                Background="White"
                                                                                Margin="0,0,0,10">
                                                                            
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="White"/>
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrincipal}"/>
                                                                                    <Style.Triggers>
                                                                                        <!-- 🔷 NUEVO: Bloqueo por calidad -->
                                                                                        <DataTrigger Binding="{Binding IsBloqueadoCalidad}" Value="True">
                                                                                            <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                                                                            <Setter Property="BorderThickness" Value="4"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid Margin="12,8">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="300"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Fila 0: Código y Descripción del artículo -->
                                                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                                                    <!-- 🔷 NUEVO: Indicador de bloqueo por calidad -->
                                                                                    <Border Background="#FF6B6B" 
                                                                                            CornerRadius="3" 
                                                                                            Padding="4,2" 
                                                                                            Margin="0,0,8,0"
                                                                                            Visibility="{Binding IsBloqueadoCalidad, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <Border.ToolTip>
                                                                                            <ToolTip>
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="Artículo bloqueado por calidad" FontWeight="Bold"/>
                                                                                                    <TextBlock Text="{Binding MotivoBloqueoCalidad}" 
                                                                                                               Visibility="{Binding MotivoBloqueoCalidad, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                                                    <TextBlock Text="{Binding FechaBloqueoCalidad, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}" 
                                                                                                               Visibility="{Binding FechaBloqueoCalidad, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                                                </StackPanel>
                                                                                            </ToolTip>
                                                                                        </Border.ToolTip>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="🔒" FontSize="12" Margin="0,0,2,0"/>
                                                                                            <TextBlock FontSize="10" 
                                                                                                       FontWeight="Bold" 
                                                                                                       Foreground="White">
                                                                                                <Run Text="BLOQUEADO CALIDAD"/>
                                                                                                <Run Text=" "/>
                                                                                                <Run Text="{Binding TipoBloqueoCalidad, Converter={StaticResource TipoBloqueoDisplayConverter}, Mode=OneWay}"/>
                                                                                            </TextBlock>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                    
                                                                                    <TextBlock Text="{Binding CodigoArticulo}"
                                                                                               FontWeight="Bold"
                                                                                               FontSize="18"
                                                                                               Foreground="{StaticResource BrushPrincipal}"
                                                                                               Margin="0,0,12,0"/>
                                                                                    <TextBlock Text="{Binding DescripcionArticulo}"
                                                                                               FontSize="16"
                                                                                               FontWeight="SemiBold"
                                                                                               Margin="0,0,0,0"/>
                                                                                </StackPanel>

                                                                                <!-- Fila 1: Almacén, Ubicación, Lote y Caducidad -->
                                                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                                                    <TextBlock Text="Almacén:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" FontSize="14"/>
                                                                                    <TextBlock Text="{Binding CodigoAlmacen}" Margin="4,0,20,0" FontSize="14"/>
                                                                                    <TextBlock Text="Ubicación:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" FontSize="14"/>
                                                                                    <TextBlock Text="{Binding Ubicacion}" Margin="4,0,20,0" FontSize="14"/>
                                                                                    <TextBlock Text="Lote:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" FontSize="14"/>
                                                                                    <TextBlock Text="{Binding Partida}" Margin="4,0,20,0" FontSize="14"/>
                                                                                    <TextBlock Text="Caducidad:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" FontSize="14"/>
                                                                                    <TextBlock Text="{Binding FechaCaducidad, StringFormat=dd/MM/yyyy}" Margin="4,0,0,0" FontSize="14"/>
                                                                                </StackPanel>

                                                                                <!-- Fila 2: Palet (si es paletizado) -->
                                                                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6"
                                                                                            Visibility="{Binding EsStockPaletizado, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                    <TextBlock Text="Palet:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" FontSize="14"/>
                                                                                    <TextBlock Text="{Binding CodigoPalet}" 
                                                                                               FontWeight="Bold" 
                                                                                               FontSize="14"
                                                                                               Margin="4,0,8,0"/>
                                                                                    <Ellipse Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                        <Ellipse.Style>
                                                                                            <Style TargetType="Ellipse">
                                                                                                <Setter Property="Fill" Value="Gray"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding EstadoPalet}" Value="Cerrado">
                                                                                                        <Setter Property="Fill" Value="Red"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding EstadoPalet}" Value="Abierto">
                                                                                                        <Setter Property="Fill" Value="Green"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding EstadoPalet}" Value="Vaciado">
                                                                                                        <Setter Property="Fill" Value="Orange"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Ellipse.Style>
                                                                                    </Ellipse>
                                                                                    <TextBlock Text="{Binding EstadoPalet}" 
                                                                                               FontWeight="Bold" 
                                                                                               Foreground="{StaticResource BrushPrincipal}"
                                                                                               FontSize="14"/>
                                                                                </StackPanel>

                                                                                <!-- Fila 3: Reservado (si hay) -->
                                                                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                                                                                    <TextBlock Text="Reservado:" FontWeight="Bold" Foreground="{StaticResource BrushPrincipal}" 
                                                                                               FontSize="14"
                                                                                               Visibility="{Binding Reservado, Converter={StaticResource ZeroToCollapsedConverter}}"/>
                                                                                    <TextBlock Text="{Binding Reservado, StringFormat='0.######'}" 
                                                                                               Margin="4,0,0,0" 
                                                                                               FontSize="14"
                                                                                               Visibility="{Binding Reservado, Converter={StaticResource ZeroToCollapsedConverter}}"/>
                                                                                </StackPanel>

                                                                                <!-- Disponible destacado a la derecha -->
                                                                                <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                                                                                        Background="#F0F6FF"
                                                                                        CornerRadius="6"
                                                                                        Padding="12,8"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        MinWidth="280">
                                                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                                                        <TextBlock Text="Disponible:" 
                                                                                                   FontWeight="Bold" 
                                                                                                   Foreground="{StaticResource BrushPrincipal}" 
                                                                                                   FontSize="15"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   Margin="0,0,0,6"/>
                                                                                        <TextBlock Text="{Binding Disponible, StringFormat='0.######'}"  
                                                                                                   FontWeight="Bold" 
                                                                                                   FontSize="24"
                                                                                                   Foreground="{Binding Disponible, Converter={StaticResource NegativeValueColorConverter}}"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   TextAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="CardBorder" Property="Background" Value="#E6F0FA"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#031ca5"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#031ca5"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!-- Botón traspasar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
            <Button Content="Traspasar" Width="140" Height="40" Style="{StaticResource EstiloBotonPrincipal}"
                    IsEnabled="{Binding StockSeleccionado, Converter={StaticResource NullToBoolConverter}}"
                    Command="{Binding AbrirDialogoTraspasoCommand}"/>
        </StackPanel>
    </Grid>
</Page> 