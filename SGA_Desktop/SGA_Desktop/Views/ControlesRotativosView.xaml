<Page x:Class="SGA_Desktop.Views.ControlesRotativosView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:SGA_Desktop.ViewModels"
      xmlns:helpers="clr-namespace:SGA_Desktop.Helpers"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d"
      Background="{StaticResource BrushFondo}">

    <Page.DataContext>
        <vm:ControlesRotativosViewModel />
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Botones de pestañas -->
            <RowDefinition Height="Auto" />
            <!-- 1: Contenido -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BOTONES DE PESTAÑAS -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="📋 Órdenes de Conteo"
                    Command="{Binding CambiarAOrdenesCommand}"
                    Width="180"
                    Height="28"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="#E8F4FD"/>
                        <Setter Property="BorderBrush" Value="#3498DB"/>
                        <Setter Property="Foreground" Value="#2980B9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoOrdenes}" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="🔍 Supervisión de Conteos"
                    Command="{Binding CambiarASupervisionCommand}"
                    Width="200"
                    Height="28"
                    Margin="0,0,5,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="#E8F4FD"/>
                        <Setter Property="BorderBrush" Value="#3498DB"/>
                        <Setter Property="Foreground" Value="#2980B9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoSupervision}" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            
            <Button Content="🔄 Conteos Periódicos"
                    Command="{Binding CambiarAPeriodicosCommand}"
                    Width="200"
                    Height="28">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource EstiloBoton}">
                        <Setter Property="Background" Value="#E8F4FD"/>
                        <Setter Property="BorderBrush" Value="#3498DB"/>
                        <Setter Property="Foreground" Value="#2980B9"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoPeriodicos}" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- CONTENIDO DE ÓRDENES DE CONTEO -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E1E5E9" 
                BorderThickness="1" 
                CornerRadius="8"
                                 Visibility="{Binding MostrandoOrdenes, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <!-- 0: Botones crear y filtros -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Lista de órdenes -->
                        <RowDefinition Height="*" />
                        <!-- 2: Botones de acción -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- BOTONES CREAR Y FILTROS -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Indicador de filtros activos -->
                        <Border Grid.Column="0" 
                                Background="#E8F4FD" 
                                BorderBrush="#3498DB" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="10,6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Visibility="{Binding TieneFiltrosActivos, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 Filtros activos: " 
                                           FontWeight="SemiBold" 
                                           FontSize="11"
                                           Foreground="#2980B9"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ResumenFiltrosActivos}" 
                                           FontSize="11"
                                           Foreground="#34495E"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Botones de acción -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Recargar"
                                    Command="{Binding CargarControlesCommand}"
                                    Style="{StaticResource EstiloBotonPrincipal}"
                                    Width="110"
                                    Height="32"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    IsEnabled="{Binding CanCargarControles}"
                                    Margin="0,0,8,0"/>
                            <Button Content="🔍 Filtros"
                                    Command="{Binding AbrirFiltrosCommand}"
                                    Style="{StaticResource EstiloBotonSecundario}"
                                    Width="110"
                                    Height="32"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    IsEnabled="{Binding CanEnableInputs}"
                                    Margin="0,0,8,0"/>
                            <Button Content="🧹 Limpiar"
                                    Command="{Binding LimpiarFiltrosCommand}"
                                    Style="{StaticResource EstiloBotonSecundario}"
                                    Width="100"
                                    Height="32"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    IsEnabled="{Binding CanEnableInputs}"
                                    Margin="0,0,10,0"/>
                            <Button Content="➕ Crear Orden de Conteo"
                                    Command="{Binding CrearControlRotativoCommand}"
                                    Style="{StaticResource EstiloBotonPrincipal}"
                                    Width="180"
                                    Height="32"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    IsEnabled="{Binding CanEnableInputs}"/>
                        </StackPanel>
                    </Grid>

                    <!-- LISTA DE ÓRDENES DE CONTEO -->
                    <GroupBox Grid.Row="1" Header="📋 Órdenes de Conteo Registradas" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Estado de carga -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" 
                                        Visibility="{Binding IsCargando, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Width="20" Height="20" 
                                             IsIndeterminate="True" 
                                             Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding MensajeEstado}" 
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushSecundario}"
                                           FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Lista de cards de órdenes de conteo -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OrdenesConteoView}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EstiloTarjeta}" 
                                                    Width="380" 
                                                    Height="Auto" 
                                                    MinHeight="280"
                                                    Margin="6"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Header con ID y Estado -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- ID -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="ID: " 
                                                                       FontWeight="Bold" 
                                                                       Foreground="{StaticResource BrushPrincipal}"
                                                                       FontSize="14"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Titulo}" 
                                                                       FontFamily="Consolas"
                                                                       FontWeight="Bold"
                                                                       Foreground="#2C3E50"
                                                                       FontSize="14"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Badge Renovación -->
                                                        <Border Grid.Column="1"
                                                                Background="#FFF3E0"
                                                                BorderBrush="#FF9800"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,3"
                                                                Margin="0,0,5,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding EsRenovacion, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🔄" 
                                                                           FontSize="11"
                                                                           Margin="0,0,3,0"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="Renovación" 
                                                                           FontWeight="SemiBold" 
                                                                           FontSize="11"
                                                                           Foreground="#E65100"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Badge Periódico (solo para el original, no para renovaciones) -->
                                                        <Border Grid.Column="2"
                                                                Background="#E7F3FF"
                                                                BorderBrush="#3498DB"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,3"
                                                                Margin="0,0,5,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding EsPeriodicoOriginal, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🔄" 
                                                                           FontSize="11"
                                                                           Margin="0,0,3,0"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock FontWeight="SemiBold" 
                                                                           FontSize="11"
                                                                           Foreground="#2980B9"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Periódico"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                                    <Setter Property="Text" Value="Pausado"/>
                                                                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                            <Setter Property="Background" Value="#ECF0F1"/>
                                                                            <Setter Property="BorderBrush" Value="#95A5A6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <!-- Estado Badge -->
                                                        <Border Grid.Column="3" 
                                                                Background="#F8F9FA" 
                                                                BorderBrush="#DEE2E6" 
                                                                BorderThickness="1" 
                                                                CornerRadius="3" 
                                                                Padding="6,3"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EstadoFormateado}" 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="PLANIFICADO">
                                                                                <Setter Property="Foreground" Value="#0D6EFD"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="ASIGNADO">
                                                                                <Setter Property="Foreground" Value="#FD7E14"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="EN_PROCESO">
                                                                                <Setter Property="Foreground" Value="#198754"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="CERRADO">
                                                                                <Setter Property="Foreground" Value="#6C757D"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Estado}" Value="CANCELADO">
                                                                                <Setter Property="Foreground" Value="#DC3545"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="PLANIFICADO">
                                                                            <Setter Property="Background" Value="#CFE2FF"/>
                                                                            <Setter Property="BorderBrush" Value="#0D6EFD"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="ASIGNADO">
                                                                            <Setter Property="Background" Value="#FFF3CD"/>
                                                                            <Setter Property="BorderBrush" Value="#FD7E14"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="EN_PROCESO">
                                                                            <Setter Property="Background" Value="#D1E7DD"/>
                                                                            <Setter Property="BorderBrush" Value="#198754"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="CERRADO">
                                                                            <Setter Property="Background" Value="#F8F9FA"/>
                                                                            <Setter Property="BorderBrush" Value="#6C757D"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Estado}" Value="CANCELADO">
                                                                            <Setter Property="Background" Value="#F8D7DA"/>
                                                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                    
                                                    <!-- Contenido principal -->
                                                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                        <!-- Almacén y Alcance -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Almacén: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CodigoAlmacen}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12"
                                                                       Foreground="#34495E"/>
                                                            <TextBlock Grid.Column="2" Text="Alcance: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"
                                                                       Margin="10,0,0,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding AlcanceFormateado, Mode=OneWay}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12"
                                                                       Foreground="#34495E"/>
                                                        </Grid>

                                                        <!-- Creador -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Creado por: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding CreadorDisplay}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12"
                                                                       Foreground="#34495E"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>

                                                        <!-- Prioridad -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Prioridad: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PrioridadTexto, Mode=OneWay}" 
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="#34495E"/>
                                                        </Grid>

                                                        <!-- Asignado a -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Asignado a: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding OperarioDisplay}" 
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="#34495E"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>

                                                        <!-- Fecha Plan (si existe) -->
                                                        <Grid Margin="0,0,0,8" Visibility="{Binding FechaPlan, Converter={StaticResource NullOrEmptyToVisibility}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Fecha Plan: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FechaPlan, StringFormat=dd/MM/yyyy}" 
                                                                       FontWeight="Bold"
                                                                       FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#34495E"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FechaPlanVencida}" Value="True">
                                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Comentarios (si existe) -->
                                                        <Grid Margin="0,0,0,8" Visibility="{Binding Comentario, Converter={StaticResource NullOrEmptyToVisibility}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Comentarios: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Comentario}" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>

                                                        <!-- Líneas Contadas -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Líneas: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="12"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding LineasContadasTexto}" 
                                                                       FontWeight="Bold" 
                                                                       FontSize="12"
                                                                       Foreground="#34495E"/>
                                                        </Grid>

                                                        <!-- Fechas: Creación y Cierre -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="Creación: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="11"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FechaCreacion, StringFormat=dd/MM/yyyy HH:mm}" 
                                                                       FontFamily="Consolas"
                                                                       FontSize="11"
                                                                       Foreground="#7F8C8D"/>
                                                            <TextBlock Grid.Column="2" Text="Cierre: " 
                                                                       FontWeight="SemiBold" 
                                                                       FontSize="11"
                                                                       Foreground="#7F8C8D"
                                                                       Margin="10,0,0,0"
                                                                       Visibility="{Binding FechaCierre, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding FechaCierre, StringFormat=dd/MM/yyyy HH:mm}" 
                                                                       FontFamily="Consolas"
                                                                       FontSize="11"
                                                                       Foreground="#7F8C8D"
                                                                       Visibility="{Binding FechaCierre, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Botones de acción -->
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!-- Botón Ver -->
                                                        <Button Content="👁️ Ver"
                                                                Command="{Binding DataContext.VerOrdenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource EstiloBoton}"
                                                                Width="60"
                                                                Height="30"
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Margin="0,0,4,0"
                                                                Visibility="{Binding PuedeVer, Converter={StaticResource BoolToVis}}"/>
                                                        
                                                        <!-- Botón Editar -->
                                                        <Button Content="✏️ Editar"
                                                                Command="{Binding DataContext.EditarOrdenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource EstiloBotonSecundario}"
                                                                Width="70"
                                                                Height="30"
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Margin="0,0,4,0"
                                                                Visibility="{Binding PuedeEditar, Converter={StaticResource BoolToVis}}"/>
                                                        
                                                        <!-- Botón Cerrar -->
                                                        <Button Content="🔒 Cerrar"
                                                                Command="{Binding DataContext.CerrarOrdenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="70"
                                                                Height="30"
                                                                FontSize="11"
                                                                FontWeight="Medium"
                                                                Visibility="{Binding PuedeCerrar, Converter={StaticResource BoolToVis}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource EstiloBotonSecundario}">
                                                                    <Setter Property="Background" Value="#FFF3CD"/>
                                                                    <Setter Property="BorderBrush" Value="#FFC107"/>
                                                                    <Setter Property="Foreground" Value="#856404"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#FFE69C"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- BOTONES DE ACCIÓN ÓRDENES -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalOrdenes}" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"
                                   FontWeight="Bold"
                                   FontSize="12"/>

                        <Button Content="📊 Exportar a Excel"
                                Command="{Binding ExportarControlesCommand}"
                                Style="{StaticResource EstiloBoton}"
                                Width="130"
                                Height="28"
                                FontSize="11"
                                IsEnabled="{Binding CanEnableInputs}"/>
                    </StackPanel>
                </Grid>
        </Border>

        <!-- CONTENIDO DE SUPERVISIÓN DE CONTEOS -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E1E5E9" 
                BorderThickness="1" 
                CornerRadius="8"
                Visibility="{Binding MostrandoSupervision, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <!-- 0: Indicador de filtros y botones -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Lista de resultados -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- INDICADOR DE FILTROS Y BOTONES -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Indicador de filtros activos -->
                        <Border Grid.Column="0" 
                                Background="#E8F4FD" 
                                BorderBrush="#3498DB" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="10,6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Visibility="{Binding TieneFiltrosActivosSupervision, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ResumenFiltrosActivosSupervision, Mode=OneWay}" 
                                       FontSize="11" 
                                       Foreground="#2980B9"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Botones -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔍 Filtros"
                                    Command="{Binding AbrirFiltrosSupervisionCommand}"
                                    Style="{StaticResource EstiloBotonSecundario}"
                                    Width="110"
                                    Height="32"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Margin="0,0,10,0"/>
                            <Button Content="🔄 Recargar"
                                    Command="{Binding CargarResultadosSupervisionCommand}"
                                    Style="{StaticResource EstiloBotonPrincipal}"
                                    Width="110"
                                    Height="32"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    IsEnabled="{Binding CanEnableInputs}"/>
                        </StackPanel>
                    </Grid>

                    <!-- LISTA DE RESULTADOS SUPERVISIÓN -->
                    <GroupBox Grid.Row="1" Header="🔍 Resultados de Supervisión" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Estado de carga -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" 
                                        Visibility="{Binding IsCargando, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Width="20" Height="20" 
                                             IsIndeterminate="True" 
                                             Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding MensajeEstado}" 
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushSecundario}"
                                           FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Lista de cards de resultados de supervisión -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ResultadosView}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EstiloTarjeta}" 
                                Width="400" 
                                Height="320" 
                                Margin="6"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header con Orden y Estado -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Orden -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Titulo}" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource BrushPrincipal}"
                                                   FontSize="14" 
                                                   TextWrapping="Wrap"
                                                   MaxWidth="280"
                                                   LineHeight="18"/>
                                    </StackPanel>

                                    <!-- Estado Badge -->
                                    <Border Grid.Column="1" 
                                            Background="#F8F9FA" 
                                            BorderBrush="#DEE2E6" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="6,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AccionFormateada}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccionFinal}" Value="SUPERVISION">
                                                            <Setter Property="Foreground" Value="#FD7E14"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccionFinal}" Value="AJUSTE">
                                                            <Setter Property="Foreground" Value="#198754"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccionFinal}" Value="APROBADO">
                                                            <Setter Property="Foreground" Value="#0D6EFD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccionFinal}" Value="SUPERVISION">
                                                        <Setter Property="Background" Value="#FFF3CD"/>
                                                        <Setter Property="BorderBrush" Value="#FD7E14"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccionFinal}" Value="AJUSTE">
                                                        <Setter Property="Background" Value="#D1E7DD"/>
                                                        <Setter Property="BorderBrush" Value="#198754"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccionFinal}" Value="APROBADO">
                                                        <Setter Property="Background" Value="#CFE2FF"/>
                                                        <Setter Property="BorderBrush" Value="#0D6EFD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                                
                                <!-- Contenido principal -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <!-- Artículo y Descripción -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Artículo: " 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12"
                                                       Foreground="#7F8C8D"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CodigoArticulo}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12"
                                                       Foreground="#34495E"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding DescripcionArticulo}" 
                                                   FontSize="11"
                                                   Foreground="#7F8C8D"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </Grid>

                                    <!-- Almacén y Ubicación -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Almacén: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CodigoAlmacen}" 
                                                   FontWeight="Bold" 
                                                   FontSize="12"
                                                   Foreground="#34495E"/>
                                        <TextBlock Grid.Column="2" Text="Ubicación: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   Foreground="#7F8C8D"
                                                   Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CodigoUbicacion}" 
                                                   FontWeight="Bold" 
                                                   FontSize="12"
                                                   Foreground="#34495E"/>
                                    </Grid>

                                    <!-- Cantidades -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Stock: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CantidadStock, StringFormat='0.########'}" 
                                                   FontSize="12"
                                                   Foreground="#34495E"/>
                                        <TextBlock Grid.Column="2" Text="Contado: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12"
                                                   Foreground="#7F8C8D"
                                                   Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CantidadContada, StringFormat='0.########'}" 
                                                   FontSize="12"
                                                   Foreground="#34495E"/>
                                    </Grid>

                                    <!-- Diferencia destacada -->
                                    <Border Background="#F8F9FA" 
                                            BorderBrush="#DEE2E6" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="8,4"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Diferencia: " 
                                                       FontWeight="Bold" 
                                                       FontSize="12"
                                                       Foreground="#7F8C8D"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DiferenciaFormateada}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Diferencia}" Value="0">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Diferencia}" Value="">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Fechas y Operario -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Fecha: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11"
                                                   Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FechaEvaluacion, StringFormat=dd/MM/yyyy HH:mm}" 
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="#7F8C8D"/>
                                    </Grid>

                                    <!-- Operario y Creado por -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Operario: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11"
                                                   Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OperarioDisplay, Mode=OneWay}" 
                                                   FontSize="11"
                                                   Foreground="#34495E"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Creado por: " 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11"
                                                   Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CreadorDisplay, Mode=OneWay}" 
                                                   FontSize="11"
                                                   Foreground="#34495E"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Botones de acción -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Botón Ver Detalles -->
                                    <Button Content="👁️ Ver"
                                            Command="{Binding DataContext.VerDetallesResultadoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource EstiloBoton}"
                                            Width="60"
                                            Height="30"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Margin="0,0,4,0"/>
                                    
                                    <!-- Botón Reasignar -->
                                    <Button Content="🔄 Reasignar"
                                            Command="{Binding DataContext.ReasignarLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource EstiloBotonSecundario}"
                                            Width="80"
                                            Height="30"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Visibility="{Binding RequiereAprobacion, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</GroupBox>

                </Grid>
        </Border>

        <!-- CONTENIDO DE CONTEOS PERIÓDICOS -->
        <Border Grid.Row="1" 
                Background="White" 
                BorderBrush="#E1E5E9" 
                BorderThickness="1" 
                CornerRadius="8"
                Visibility="{Binding MostrandoPeriodicos, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header con botones -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Indicador de filtros activos -->
                    <Border Grid.Column="0" 
                            Background="#E8F4FD" 
                            BorderBrush="#3498DB" 
                            BorderThickness="1" 
                            CornerRadius="5" 
                            Padding="10,6"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Visibility="{Binding TieneFiltrosActivosPeriodicos, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResumenFiltrosActivosPeriodicos, Mode=OneWay}" 
                                   FontSize="11" 
                                   Foreground="#2980B9"
                                   TextWrapping="Wrap"/>
                    </Border>
                    
                    <!-- Botones -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔍 Filtros"
                                Command="{Binding AbrirFiltrosConteosPeriodicosCommand}"
                                Style="{StaticResource EstiloBotonSecundario}"
                                Width="110"
                                Height="32"
                                Margin="0,0,10,0"/>
                        <Button Content="🔄 Recargar"
                                Command="{Binding CargarConteosPeriodicosCommand}"
                                Style="{StaticResource EstiloBotonPrincipal}"
                                Width="110"
                                Height="32"/>
                    </StackPanel>
                </Grid>

                <!-- Lista de conteos periódicos -->
                <GroupBox Grid.Row="1" Header="🔄 Conteos Periódicos Registrados" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Estado de carga -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" 
                                    Visibility="{Binding IsCargando, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="20" Height="20" 
                                         IsIndeterminate="True" 
                                         Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding MensajeEstado}" 
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushSecundario}"
                                       FontStyle="Italic"/>
                        </StackPanel>

                        <!-- Lista de cards de conteos periódicos -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ConteosPeriodicos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#DEE2E6"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="5"
                                                Padding="12"
                                                Width="380"
                                                MaxWidth="380">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header con título y estado -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Titulo}" 
                                                               FontWeight="Bold" 
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,60,0"/>
                                                    <Border HorizontalAlignment="Right"
                                                            CornerRadius="3"
                                                            Padding="6,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#28A745"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Background" Value="#DC3545"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Activo"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                            <Setter Property="Text" Value="Inactivo"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <!-- Información del conteo -->
                                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Frecuencia: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding FrecuenciaDias}"/>
                                                        <Run Text=" días"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Última renovación: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding FechaUltimaRenovacion, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='Nunca'}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Próxima renovación: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding FechaProximaRenovacion, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='No programada'}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Total renovaciones: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding TotalRenovaciones}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Estado: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Estado}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" Visibility="{Binding CodigoOperario, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <Run Text="Operario: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding OperarioDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" Visibility="{Binding CodigoAlmacen, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <Run Text="Almacén: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding CodigoAlmacen}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Alcance: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding AlcanceFormateado, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Creado por: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding CreadorDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Prioridad: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding PrioridadTexto, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="Fecha creación: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding FechaCreacion, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Botones de acción -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✅ Activar"
                                                            Command="{Binding DataContext.ActivarPeriodicidadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EstiloBoton}"
                                                            Width="100"
                                                            Height="30"
                                                            FontSize="11"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding Activo, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                    <Button Content="⏸️ Desactivar"
                                                            Command="{Binding DataContext.DesactivarPeriodicidadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EstiloBotonSecundario}"
                                                            Width="100"
                                                            Height="30"
                                                            FontSize="11"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding Activo, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="📋 Historial"
                                                            Command="{Binding DataContext.VerRenovacionesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EstiloBoton}"
                                                            Width="80"
                                                            Height="30"
                                                            FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</Page> 